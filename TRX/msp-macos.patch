 static M_CONTEXT m_Context = {};
+
+#if defined(__APPLE__)
+// MacSourcePorts: one TRX build ships as an app per game. The app's
+// Info.plist names the game's folder in ~/Library/Application Support
+// (MSPDataFolder, e.g. TombRaider1), which holds the original game's files
+// as the GOG, Steam or CD release installs them: data/, fmv/, music/,
+// audio/, cuts/. TR1 can stay as the GOG/Steam disc image (GAME.GOG, a
+// .bin or .iso), from which data/ and fmv/ are extracted on the first run,
+// with its music as the 02.mp3 ... files beside it. The settings, saves,
+// screenshots and cache go in ~/Library/Application Support/TRX, since the
+// app bundle can't be written to. Outside such an app nothing changes.
+#include <CoreFoundation/CoreFoundation.h>
+#include <dirent.h>
+#include <stdio.h>
+#include <strings.h>
+#include <sys/stat.h>
+
+static char *m_MSPDataDir = nullptr;
+static char *m_MSPMusicDir = nullptr;
+
+static char *M_MSPGetBundleString(const char *const key)
+{
+    CFStringRef cf_key = CFStringCreateWithCString(
+        nullptr, key, kCFStringEncodingUTF8);
+    CFTypeRef value = CFBundleGetValueForInfoDictionaryKey(
+        CFBundleGetMainBundle(), cf_key);
+    CFRelease(cf_key);
+    char buffer[256];
+    if (value == nullptr || CFGetTypeID(value) != CFStringGetTypeID()
+        || !CFStringGetCString(
+            (CFStringRef)value, buffer, sizeof(buffer), kCFStringEncodingUTF8)
+        || buffer[0] == '\0') {
+        return nullptr;
+    }
+    return Memory_DupStr(buffer);
+}
+
+static void M_MSPMakeDir(const char *const path)
+{
+    // mkdir -p
+    char *tmp = Memory_DupStr(path);
+    for (char *p = tmp + 1; *p != '\0'; p++) {
+        if (*p == '/') {
+            *p = '\0';
+            mkdir(tmp, 0755);
+            *p = '/';
+        }
+    }
+    mkdir(tmp, 0755);
+    Memory_FreePointer(&tmp);
+}
+
+static void M_MSPSetDirEnv(
+    const char *const env_name, const char *const base, const char *const name)
+{
+    if (getenv(env_name) != nullptr) {
+        return;
+    }
+    char *path = String_Format("%s/%s", base, name);
+    M_MSPMakeDir(path);
+    setenv(env_name, path, 0);
+    Memory_FreePointer(&path);
+}
+
+// The entry of dir named name, in any case, or nullptr
+static char *M_MSPFindEntry(
+    const char *const dir, const char *const name, const bool want_dir)
+{
+    DIR *const d = opendir(dir);
+    if (d == nullptr) {
+        return nullptr;
+    }
+    char *result = nullptr;
+    struct dirent *e;
+    while (result == nullptr && (e = readdir(d)) != nullptr) {
+        if (strcasecmp(e->d_name, name) != 0) {
+            continue;
+        }
+        char *path = String_Format("%s/%s", dir, e->d_name);
+        struct stat st;
+        if (stat(path, &st) == 0 && S_ISDIR(st.st_mode) == want_dir) {
+            result = path;
+        } else {
+            Memory_FreePointer(&path);
+        }
+    }
+    closedir(d);
+    return result;
+}
+
+// A CD image: 2048-byte ISO sectors, or 2352-byte raw sectors with the
+// 2048 bytes of data at an offset that depends on the sector mode
+typedef struct {
+    FILE *fp;
+    long sector_size;
+    long data_offset;
+} M_MSP_DISC;
+
+static bool M_MSPReadSector(
+    const M_MSP_DISC *const disc, const uint32_t lba, uint8_t *const out)
+{
+    return fseeko(
+               disc->fp,
+               (off_t)lba * disc->sector_size + disc->data_offset, SEEK_SET)
+        == 0
+        && fread(out, 1, 2048, disc->fp) == 2048;
+}
+
+static bool M_MSPOpenDisc(const char *const path, M_MSP_DISC *const disc)
+{
+    static const long layouts[][2] = { { 2048, 0 }, { 2352, 16 }, { 2352, 24 } };
+    disc->fp = fopen(path, "rb");
+    if (disc->fp == nullptr) {
+        return false;
+    }
+    for (size_t i = 0; i < ARRAY_SIZE(layouts); i++) {
+        disc->sector_size = layouts[i][0];
+        disc->data_offset = layouts[i][1];
+        uint8_t sector[2048];
+        if (M_MSPReadSector(disc, 16, sector) && sector[0] == 1
+            && memcmp(sector + 1, "CD001", 5) == 0) {
+            return true;
+        }
+    }
+    fclose(disc->fp);
+    disc->fp = nullptr;
+    return false;
+}
+
+static uint32_t M_MSPLE32(const uint8_t *const p)
+{
+    return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+typedef bool (*M_MSP_DIR_VISITOR)(
+    const M_MSP_DISC *disc, const char *name, bool is_dir, uint32_t lba,
+    uint32_t size, void *user_data);
+
+static bool M_MSPWalkDir(
+    const M_MSP_DISC *const disc, const uint32_t lba, const uint32_t size,
+    const M_MSP_DIR_VISITOR visitor, void *const user_data)
+{
+    uint8_t sector[2048];
+    for (uint32_t offset = 0; offset < size; offset += 2048) {
+        if (!M_MSPReadSector(disc, lba + offset / 2048, sector)) {
+            return false;
+        }
+        for (uint32_t pos = 0; pos < 2048 && sector[pos] != 0;
+             pos += sector[pos]) {
+            const uint8_t *const rec = sector + pos;
+            const uint8_t name_len = rec[32];
+            if (rec[0] < 34 || pos + rec[0] > 2048 || 33 + name_len > rec[0]) {
+                break;
+            }
+            if (name_len == 1 && (rec[33] == 0 || rec[33] == 1)) {
+                continue; // . and ..
+            }
+            char name[256];
+            memcpy(name, rec + 33, name_len);
+            name[name_len] = '\0';
+            char *version = strchr(name, ';');
+            if (version != nullptr) {
+                *version = '\0';
+            }
+            const size_t len = strlen(name);
+            if (len > 0 && name[len - 1] == '.') {
+                name[len - 1] = '\0';
+            }
+            if (!visitor(
+                    disc, name, (rec[25] & 2) != 0, M_MSPLE32(rec + 2),
+                    M_MSPLE32(rec + 10), user_data)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static bool M_MSPExtractFile(
+    const M_MSP_DISC *const disc, const char *const name, const bool is_dir,
+    const uint32_t lba, const uint32_t size, void *const user_data)
+{
+    if (is_dir) {
+        return true;
+    }
+    char *path = String_Format("%s/%s", (const char *)user_data, name);
+    FILE *const out = fopen(path, "wb");
+    Memory_FreePointer(&path);
+    if (out == nullptr) {
+        return false;
+    }
+    uint8_t sector[2048];
+    bool ok = true;
+    for (uint32_t done = 0; ok && done < size; done += 2048) {
+        const uint32_t chunk = size - done < 2048 ? size - done : 2048;
+        ok = M_MSPReadSector(disc, lba + done / 2048, sector)
+            && fwrite(sector, 1, chunk, out) == chunk;
+    }
+    return fclose(out) == 0 && ok;
+}
+
+typedef struct {
+    const char *staging_dir;
+    bool ok;
+    int32_t extracted;
+} M_MSP_EXTRACT_CONTEXT;
+
+static bool M_MSPExtractTopDir(
+    const M_MSP_DISC *const disc, const char *const name, const bool is_dir,
+    const uint32_t lba, const uint32_t size, void *const user_data)
+{
+    M_MSP_EXTRACT_CONTEXT *const ctx = user_data;
+    if (!is_dir
+        || (strcasecmp(name, "data") != 0 && strcasecmp(name, "fmv") != 0)) {
+        return true;
+    }
+    char *dir = String_Format("%s/%s", ctx->staging_dir, name);
+    mkdir(dir, 0755);
+    ctx->ok &= M_MSPWalkDir(disc, lba, size, M_MSPExtractFile, dir);
+    Memory_FreePointer(&dir);
+    ctx->extracted++;
+    return ctx->ok;
+}
+
+static void M_MSPRemoveTree(const char *const path)
+{
+    DIR *const d = opendir(path);
+    if (d != nullptr) {
+        struct dirent *e;
+        while ((e = readdir(d)) != nullptr) {
+            if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) {
+                continue;
+            }
+            char *child = String_Format("%s/%s", path, e->d_name);
+            M_MSPRemoveTree(child);
+            Memory_FreePointer(&child);
+        }
+        closedir(d);
+        rmdir(path);
+    } else {
+        unlink(path);
+    }
+}
+
+// Extracts data/ and fmv/ from the first CD image in the game's folder,
+// unless it has a data folder already
+static void M_MSPExtractDiscImage(const char *const data_dir)
+{
+    char *existing = M_MSPFindEntry(data_dir, "data", true);
+    if (existing != nullptr) {
+        Memory_FreePointer(&existing);
+        return;
+    }
+
+    DIR *const d = opendir(data_dir);
+    if (d == nullptr) {
+        return;
+    }
+    M_MSP_DISC disc = {};
+    struct dirent *e;
+    while (disc.fp == nullptr && (e = readdir(d)) != nullptr) {
+        const char *ext = strrchr(e->d_name, '.');
+        if (ext == nullptr
+            || (strcasecmp(ext, ".gog") != 0 && strcasecmp(ext, ".iso") != 0
+                && strcasecmp(ext, ".bin") != 0
+                && strcasecmp(ext, ".img") != 0)) {
+            continue;
+        }
+        char *path = String_Format("%s/%s", data_dir, e->d_name);
+        if (M_MSPOpenDisc(path, &disc)) {
+            fprintf(stderr, "Extracting the game's files from %s\n", path);
+        }
+        Memory_FreePointer(&path);
+    }
+    closedir(d);
+    if (disc.fp == nullptr) {
+        return;
+    }
+
+    char *staging = String_Format("%s/.extracting", data_dir);
+    M_MSPRemoveTree(staging);
+    M_MSPMakeDir(staging);
+    M_MSP_EXTRACT_CONTEXT ctx = { .staging_dir = staging, .ok = true };
+    uint8_t pvd[2048];
+    if (M_MSPReadSector(&disc, 16, pvd)) {
+        const uint8_t *const root = pvd + 156;
+        ctx.ok = M_MSPWalkDir(
+            &disc, M_MSPLE32(root + 2), M_MSPLE32(root + 10),
+            M_MSPExtractTopDir, &ctx);
+    } else {
+        ctx.ok = false;
+    }
+    fclose(disc.fp);
+
+    // Move the folders into place only once everything is out
+    if (ctx.ok && ctx.extracted > 0) {
+        DIR *const sd = opendir(staging);
+        while (sd != nullptr && (e = readdir(sd)) != nullptr) {
+            if (e->d_name[0] == '.') {
+                continue;
+            }
+            char *from = String_Format("%s/%s", staging, e->d_name);
+            char *to = String_Format("%s/%s", data_dir, e->d_name);
+            char *clash = M_MSPFindEntry(data_dir, e->d_name, true);
+            if (clash == nullptr) {
+                rename(from, to);
+            }
+            Memory_FreePointer(&clash);
+            Memory_FreePointer(&from);
+            Memory_FreePointer(&to);
+        }
+        if (sd != nullptr) {
+            closedir(sd);
+        }
+    } else {
+        fprintf(stderr, "Could not extract the game's files\n");
+    }
+    M_MSPRemoveTree(staging);
+    Memory_FreePointer(&staging);
+}
+
+static bool M_MSPIsTrackFile(const char *const name)
+{
+    int32_t id;
+    int32_t len = 0;
+    const char *digits = name;
+    if (strncasecmp(digits, "track_", 6) == 0) {
+        digits += 6;
+    } else if (strncasecmp(digits, "track", 5) == 0) {
+        digits += 5;
+    }
+    if (sscanf(digits, "%d%n", &id, &len) != 1 || digits[len] != '.') {
+        return false;
+    }
+    const char *ext = digits + len;
+    return strcasecmp(ext, ".mp3") == 0 || strcasecmp(ext, ".ogg") == 0
+        || strcasecmp(ext, ".flac") == 0 || strcasecmp(ext, ".wav") == 0;
+}
+
+// The music: a music folder, or numbered tracks (02.mp3, track02.ogg,
+// track_02.ogg) loose in the game's folder, as GOG's TR1 has them
+static char *M_MSPFindMusicDir(const char *const data_dir)
+{
+    char *music = M_MSPFindEntry(data_dir, "music", true);
+    if (music != nullptr) {
+        return music;
+    }
+    DIR *const d = opendir(data_dir);
+    if (d == nullptr) {
+        return nullptr;
+    }
+    bool found = false;
+    struct dirent *e;
+    while (!found && (e = readdir(d)) != nullptr) {
+        found = M_MSPIsTrackFile(e->d_name);
+    }
+    closedir(d);
+    return found ? Memory_DupStr(data_dir) : nullptr;
+}
+
+static void M_MSPSetup(void)
+{
+    static bool done = false;
+    if (done) {
+        return;
+    }
+    done = true;
+
+    char *folder = M_MSPGetBundleString("MSPDataFolder");
+    const char *home = getenv("HOME");
+    if (folder == nullptr || home == nullptr) {
+        Memory_FreePointer(&folder);
+        return;
+    }
+
+    char *trx_support =
+        String_Format("%s/Library/Application Support/TRX", home);
+    M_MSPSetDirEnv("TRX_CONFIG_DIR", trx_support, "cfg");
+    M_MSPSetDirEnv("TRX_CACHE_DIR", trx_support, "cache");
+    M_MSPSetDirEnv("TRX_SAVES_DIR", trx_support, "saves");
+    M_MSPSetDirEnv("TRX_SCREENSHOTS_DIR", trx_support, "screenshots");
+    Memory_FreePointer(&trx_support);
+
+    m_MSPDataDir =
+        String_Format("%s/Library/Application Support/%s", home, folder);
+    Memory_FreePointer(&folder);
+    M_MSPMakeDir(m_MSPDataDir);
+    M_MSPExtractDiscImage(m_MSPDataDir);
+    m_MSPMusicDir = M_MSPFindMusicDir(m_MSPDataDir);
+}
+#endif
