diff --git a/Source/ResourceMan.cpp b/Source/ResourceMan.cpp
index bf893a6..9aa69a1 100644
--- a/Source/ResourceMan.cpp
+++ b/Source/ResourceMan.cpp
@@ -335,6 +335,29 @@ void cResourceMan::addDefaultDirs() {
 	}
 	//Fallback to /usr/local/share
 	addBaseDir("/usr/local/share/");
+
+#ifdef __APPLE__
+	// The per-user folder the installer writes to (InstallPaths.cpp)
+	path1 = std::getenv("HOME");
+	if (path1 && *path1) {
+		// (the working directory already, when launched from the app bundle)
+		std::error_code ec;
+		const std::string appSupport = std::string(path1) + "/Library/Application Support/OpenFodder";
+		if (!std::filesystem::equivalent(appSupport, getcwd(), ec))
+			addBaseDir(std::string(path1) + "/Library/Application Support/");
+	}
+
+	// The data (campaigns, scripts, demos) bundled in the app's Resources,
+	// searched last so anything in the per-user folder wins
+	const char* base = SDL_GetBasePath();
+	if (base && *base) {
+		std::string resources = base;
+		if (resources.back() != '/')
+			resources.append("/");
+		if (std::find(mAllPaths.begin(), mAllPaths.end(), resources) == mAllPaths.end())
+			mAllPaths.push_back(resources);
+	}
+#endif
 #endif
 }
 
