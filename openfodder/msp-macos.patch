+#ifdef __APPLE__
+#include <filesystem>
+
+// Launched from an app bundle, the working directory is "/". Use the
+// per-user data folder (~/Library/Application Support/OpenFodder) instead,
+// so the INI, saves and retail data live there; the bundled data in
+// Contents/Resources is searched after it (see cResourceMan::addDefaultDirs).
+static void macOSUseAppSupport() {
+	const char* base = SDL_GetBasePath();
+	if (!base || !std::strstr(base, ".app/Contents/Resources"))
+		return;
+
+	const char* home = std::getenv("HOME");
+	if (!home || !*home)
+		return;
+
+	const std::filesystem::path root = std::filesystem::path(home) / "Library" / "Application Support" / "OpenFodder";
+	std::error_code ec;
+	for (const char* sub : { "Data/Dos_CD", "Data/Dos2_CD", "Saves" })
+		std::filesystem::create_directories(root / sub, ec);
+	std::filesystem::current_path(root, ec);
+}
+#endif
+
