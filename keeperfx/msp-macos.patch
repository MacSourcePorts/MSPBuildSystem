 #include "post_inc.h"
 
 thread_local bool g_on_render_thread = false;
 
+// Wait on the condition variable. On macOS, SDL's GL swap on the render
+// thread sometimes has the main thread do part of the work (dispatch_sync to
+// the main queue, e.g. after the window changed), so the main thread has to
+// keep its run loop going while it waits, or both wait for each other forever.
+template <typename Pred>
+static void wait_for_render_thread(std::unique_lock<std::mutex> &lock, std::condition_variable &cv, Pred pred)
+{
+#if defined(__APPLE__)
+    if (pthread_main_np())
+    {
+        while (!cv.wait_for(lock, std::chrono::milliseconds(1), pred))
+        {
+            lock.unlock();
+            CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0, true);
+            lock.lock();
+        }
+        return;
+    }
+#endif
+    cv.wait(lock, pred);
+}
