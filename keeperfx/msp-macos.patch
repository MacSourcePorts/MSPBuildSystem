diff --git a/src/kfx/platform/MacAppSupport.cpp b/src/kfx/platform/MacAppSupport.cpp
new file mode 100644
index 000000000..9c8c7c4b0
--- /dev/null
+++ b/src/kfx/platform/MacAppSupport.cpp
@@ -0,0 +1,249 @@
+/******************************************************************************/
+// macOS app bundle support (Mac Source Ports).
+//
+// KeeperFX expects one folder holding everything: its own data, the files
+// from the original Dungeon Keeper, and the player's saves, screenshots,
+// settings and log. In a Mac app its own data is inside the (read-only,
+// signed) app bundle, in Contents/Resources/keeperfx, so this sets up
+// ~/Library/Application Support/KeeperFX as that folder:
+//
+// - each folder of the bundled data gets a real folder there, filled with
+//   symlinks to the bundled files. They're recreated at every launch, so they
+//   follow the app when it's moved or updated, and the player can add their
+//   own files (campaigns, maps, mods) next to them.
+// - keeperfx.cfg is copied, so it can be edited.
+// - the original Dungeon Keeper files (data/*.dat etc., sound/*.sbk) and the
+//   GOG release's music (keeper02.ogg ...) are copied in from a "Dungeon
+//   Keeper" folder there, where the player puts their copy of the game.
+//
+// Then the game runs as if it had been started from that folder.
+/******************************************************************************/
+#if defined(__APPLE__)
+
+#include "kfx/platform/MacAppSupport.h"
+#include <SDL3/SDL.h>
+#include <filesystem>
+#include <string>
+#include <vector>
+#include <map>
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <cstdio>
+#include <unistd.h>
+
+namespace fs = std::filesystem;
+
+namespace {
+
+const char *kAppSupportName = "KeeperFX";
+const char *kOriginalGameFolder = "Dungeon Keeper";
+
+// docs/files_required_from_original_dk.txt
+const char *kRequiredFiles[] = {
+    "data/bluepal.dat", "data/bluepall.dat", "data/dogpal.pal", "data/hitpall.dat",
+    "data/lightng.pal", "data/main.pal", "data/mapfadeg.dat", "data/redpal.col",
+    "data/redpall.dat", "data/slab0-0.dat", "data/slab0-1.dat", "data/vampal.pal",
+    "data/whitepal.col",
+    "sound/atmos1.sbk", "sound/atmos2.sbk", "sound/bullfrog.sbk",
+};
+
+std::string lower(std::string s)
+{
+    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return (char)std::tolower(c); });
+    return s;
+}
+
+// Is this one of our symlinks into an app bundle's data?
+bool is_bundle_link(const fs::path &p)
+{
+    std::error_code ec;
+    if (!fs::is_symlink(fs::symlink_status(p, ec)))
+        return false;
+    fs::path target = fs::read_symlink(p, ec);
+    return !ec && target.string().find(".app/Contents/Resources/") != std::string::npos;
+}
+
+void link_entry(const fs::path &src, const fs::path &dst)
+{
+    std::error_code ec;
+    // a real file or folder of the player's own wins over the bundled one
+    if (fs::exists(fs::symlink_status(dst, ec)))
+        return;
+    fs::create_symlink(src, dst, ec);
+    if (ec)
+        fprintf(stderr, "KeeperFX: can't link %s: %s\n", dst.c_str(), ec.message().c_str());
+}
+
+// Mirror the bundled data into the Application Support folder
+void link_bundled_data(const fs::path &bundle, const fs::path &base)
+{
+    std::error_code ec;
+    // first remove the links made by the last launch (maybe from an older
+    // copy of the app, which may have had other files)
+    for (auto &top : fs::directory_iterator(base, ec)) {
+        if (is_bundle_link(top.path())) {
+            fs::remove(top.path(), ec);
+            continue;
+        }
+        if (top.is_directory(ec) && !top.is_symlink(ec)) {
+            for (auto &child : fs::directory_iterator(top.path(), ec)) {
+                if (is_bundle_link(child.path()))
+                    fs::remove(child.path(), ec);
+            }
+        }
+    }
+
+    for (auto &top : fs::directory_iterator(bundle, ec)) {
+        const fs::path name = top.path().filename();
+        const fs::path dst = base / name;
+        if (top.is_directory(ec)) {
+            fs::create_directories(dst, ec);
+            for (auto &child : fs::directory_iterator(top.path(), ec))
+                link_entry(child.path(), dst / child.path().filename());
+        } else if (name == "keeperfx.cfg") {
+            if (!fs::exists(dst, ec))
+                fs::copy_file(top.path(), dst, ec);
+        } else {
+            link_entry(top.path(), dst);
+        }
+    }
+}
+
+// All files under a folder, by lower-case path relative to it
+std::map<std::string, fs::path> index_files(const fs::path &root)
+{
+    std::map<std::string, fs::path> files;
+    std::error_code ec;
+    auto it = fs::recursive_directory_iterator(root, fs::directory_options::skip_permission_denied, ec);
+    for (; !ec && it != fs::recursive_directory_iterator(); it.increment(ec)) {
+        if (it->is_regular_file(ec))
+            files.emplace(lower(fs::relative(it->path(), root, ec).string()), it->path());
+    }
+    return files;
+}
+
+// Find a file by name: at the same relative path, or anywhere if not there
+// (the player may have put the DATA and SOUND folders one level down)
+const fs::path *find_file(const std::map<std::string, fs::path> &files, const std::string &rel)
+{
+    auto it = files.find(rel);
+    if (it != files.end())
+        return &it->second;
+    for (auto &f : files) {
+        const std::string &key = f.first;
+        if (key.size() > rel.size() && key.compare(key.size() - rel.size(), rel.size(), rel) == 0
+            && key[key.size() - rel.size() - 1] == '/')
+            return &f.second;
+    }
+    return nullptr;
+}
+
+// Copy what's needed from the player's copy of Dungeon Keeper; returns the
+// required files still missing
+std::vector<std::string> import_original_files(const fs::path &base)
+{
+    std::vector<std::string> missing;
+    std::error_code ec;
+    const fs::path original = base / kOriginalGameFolder;
+    std::map<std::string, fs::path> files;
+    if (fs::is_directory(original, ec))
+        files = index_files(original);
+
+    for (const char *req : kRequiredFiles) {
+        const fs::path dst = base / req;
+        if (fs::exists(dst, ec))
+            continue;
+        const fs::path *src = files.empty() ? nullptr : find_file(files, req);
+        if (src == nullptr || !fs::copy_file(*src, dst, ec))
+            missing.push_back(req);
+    }
+
+    // The GOG release's music (keeper02.ogg - keeper07.ogg) goes in music/,
+    // if there isn't any music there yet
+    const fs::path music = base / "music";
+    bool have_music = false;
+    for (auto &f : fs::directory_iterator(music, ec)) {
+        if (lower(f.path().extension().string()) == ".ogg") {
+            have_music = true;
+            break;
+        }
+    }
+    if (!have_music) {
+        for (auto &f : files) {
+            const std::string name = lower(f.second.filename().string());
+            if (name.rfind("keeper", 0) == 0 && f.second.extension() == ".ogg"
+                && f.first.find('/') == std::string::npos) {
+                fs::create_directories(music, ec);
+                fs::copy_file(f.second, music / name, ec);
+            }
+        }
+    }
+    return missing;
+}
+
+void show_missing_files(const fs::path &base, const std::vector<std::string> &missing)
+{
+    const fs::path original = base / kOriginalGameFolder;
+    std::error_code ec;
+    fs::create_directories(original, ec);
+
+    std::string list;
+    for (size_t i = 0; i < missing.size() && i < 6; i++)
+        list += "    " + missing[i] + "\n";
+    if (missing.size() > 6)
+        list += "    ... and " + std::to_string(missing.size() - 6) + " more\n";
+
+    std::string msg =
+        "KeeperFX needs some files from the original Dungeon Keeper (CD, GOG or EA release).\n\n"
+        "Copy your Dungeon Keeper folder's contents (the folder with DATA and SOUND in it) into:\n\n"
+        "    ~/Library/Application Support/" + std::string(kAppSupportName) + "/" + kOriginalGameFolder + "\n\n"
+        "and start KeeperFX again. That folder will now open in the Finder.\n\n"
+        "Missing:\n" + list;
+    SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_INFORMATION, "KeeperFX", msg.c_str(), nullptr);
+    std::string url = "file://" + original.string();
+    for (size_t i = 0; (i = url.find(' ', i)) != std::string::npos; i += 3)
+        url.replace(i, 1, "%20");
+    SDL_OpenURL(url.c_str());
+}
+
+std::string g_argv0;
+
+} // namespace
+
+extern "C" int kfx_macos_prepare(int *argc, char ***argv)
+{
+    (void)argc;
+    const char *base_path = SDL_GetBasePath(); // Contents/Resources/ in an app bundle
+    if (base_path == nullptr)
+        return 0;
+    const fs::path bundle = fs::path(base_path) / "keeperfx";
+    std::error_code ec;
+    if (!fs::is_directory(bundle, ec))
+        return 0; // not the app bundle: run from the executable's folder, as on Linux
+
+    const char *home = getenv("HOME");
+    if (home == nullptr)
+        return 0;
+    const fs::path base = fs::path(home) / "Library" / "Application Support" / kAppSupportName;
+    fs::create_directories(base, ec);
+    if (ec) {
+        fprintf(stderr, "KeeperFX: can't create %s: %s\n", base.c_str(), ec.message().c_str());
+        return 0;
+    }
+
+    link_bundled_data(bundle, base);
+    std::vector<std::string> missing = import_original_files(base);
+    if (!missing.empty()) {
+        show_missing_files(base, missing);
+        return 1;
+    }
+
+    // KeeperFX takes its folder from argv[0]; also make it the current folder
+    chdir(base.c_str());
+    g_argv0 = (base / "keeperfx").string();
+    (*argv)[0] = g_argv0.data();
+    return 0;
+}
+
+#endif
