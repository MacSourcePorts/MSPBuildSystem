+/* MacSourcePorts: on a Mac whose display has a camera notch, a fullscreen
+ * window covers the strip beside the notch too, so the top of the picture is
+ * hidden behind it. Keep FULLSCREEN_WINDOW displays to the area below (the
+ * screen's safe area) and black out the strip, as macOS does for its own
+ * fullscreen windows.
+ */
+static NSWindow *notch_cover_window = nil;
+
+static CGFloat screen_top_inset(NSScreen *screen)
+{
+#if __MAC_OS_X_VERSION_MAX_ALLOWED >= 120000
+   if (@available(macOS 12.0, *)) {
+      return [screen safeAreaInsets].top;
+   }
+#endif
+   (void)screen;
+   return 0;
+}
+
+static NSRect fullscreen_window_frame(NSScreen *screen)
+{
+   NSRect rc = [screen frame];
+   rc.size.height -= screen_top_inset(screen);
+   return rc;
+}
+
+static void remove_notch_cover(void)
+{
+   if (notch_cover_window) {
+      [notch_cover_window close];
+      [notch_cover_window release];
+      notch_cover_window = nil;
+   }
+}
+
 @implementation ALOpenGLView
 
