    /* HACK? For some reason, we need to disable the chrome. If we don't, the fullscreen window
       will be created with space left over for it. Are we creating a fullscreen window in the wrong way? */
    [dpy->win setStyleMask: [dpy->win styleMask] & ~NSWindowStyleMaskTitled];
-   [dpy->view enterFullScreenMode: [dpy->win screen] withOptions: dict];
+   NSScreen *screen = [dpy->win screen];
+   [dpy->view enterFullScreenMode: screen withOptions: dict];
    [dict release];
+   CGFloat inset = screen_top_inset(screen);
+   if (inset > 0) {
+      NSWindow *fs = [dpy->view window];
+      NSRect sc = [screen frame];
+      NSRect strip = NSMakeRect(sc.origin.x, NSMaxY(sc) - inset, sc.size.width, inset);
+      [fs setFrame: fullscreen_window_frame(screen) display: YES];
+      remove_notch_cover();
+      notch_cover_window = [[NSWindow alloc] initWithContentRect: strip
+         styleMask: NSWindowStyleMaskBorderless backing: NSBackingStoreBuffered defer: NO];
+      [notch_cover_window setReleasedWhenClosed: NO];
+      [notch_cover_window setBackgroundColor: [NSColor blackColor]];
+      [notch_cover_window setIgnoresMouseEvents: YES];
+      [notch_cover_window setLevel: [fs level]];
+      [notch_cover_window orderFront: nil];
+   }
 #endif
 }
 
