@@ -0,0 +1,10 @@
+cmake_minimum_required (VERSION 3.16)
+project (AngelScript)
+
+# The native calling conventions are chosen by as_config.h; the files for
+# other CPUs compile to nothing. (The .asm/.S/.s ones are for MSVC and
+# 32-bit ARM, not needed here.)
+file(GLOB angelscript_sources ${CMAKE_CURRENT_SOURCE_DIR}/sources/*.cpp)
+
+add_library(AngelScript STATIC ${angelscript_sources})
+target_include_directories(AngelScript PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
diff --git a/HPL2/dependencies/sources/AngelScript/sources/as_callfunc.cpp b/HPL2/dependencies/sources/AngelScript/sources/as_callfunc.cpp
index f1c1901..b647297 100644
--- a/HPL2/dependencies/sources/AngelScript/sources/as_callfunc.cpp
+++ b/HPL2/dependencies/sources/AngelScript/sources/as_callfunc.cpp
@@ -91,6 +91,15 @@ int DetectCallingConvention(bool isMethod, const asSFuncPtr &ptr, int callConv,
 			if( (size_t(internal->baseOffset) & 1) )
 				internal->callConv = ICC_VIRTUAL_THISCALL;
 #endif
+#if defined(AS_ARM64) && defined(__GNUC__)
+			// The ARM C++ ABI stores the this-adjustment shifted left by one,
+			// with the least significant bit flagging a virtual method (whose
+			// pointer is then the vtable offset in bytes). baseOffset keeps
+			// that form, as CallObjectMethod rebuilds method pointers from it;
+			// CallSystemFunction shifts it back.
+			if( (size_t(internal->baseOffset) & 1) )
+				internal->callConv = ICC_VIRTUAL_THISCALL;
+#endif
 
 #ifdef HAVE_VIRTUAL_BASE_OFFSET
 			// We don't support virtual inheritance
