+
+//
+// as_callfunc_arm64.cpp
+//
+// Native calling conventions for 64-bit ARM on Apple platforms (Apple
+// silicon Macs). Added for the macOS arm64 build; not part of upstream
+// AngelScript 2.19 (ported from the one written for AngelScript 2.24 in
+// NakedMachineForPigs).
+//
+// Apple's arm64 ABI is AAPCS64 with these differences that matter here:
+//  - arguments passed on the stack are packed at their natural size and
+//    alignment rather than in 8 byte slots
+//  - the caller sign/zero extends integer arguments narrower than 32 bits
+// As in AAPCS64, a return value that doesn't fit in registers is written
+// to memory pointed to by x8 (not passed as a hidden first argument), and
+// objects with a non-trivial copy constructor or destructor are passed by
+// a pointer to a copy owned by the caller.
+//
+
+#include "as_config.h"
+
+#ifndef AS_MAX_PORTABILITY
+#ifdef AS_ARM64
+
+#include "as_callfunc.h"
+#include "as_scriptengine.h"
+#include "as_texts.h"
+#include "as_context.h"
+
+BEGIN_AS_NAMESPACE
+
+#define ARM64_MAX_GP_REGS    8
+#define ARM64_MAX_FP_REGS    8
+#define ARM64_MAX_STACK      1024
+
+struct asSARM64Regs
+{
+	asQWORD gp[ARM64_MAX_GP_REGS + 1]; // x0-x7, then x8 (indirect result)
+	asQWORD fp[ARM64_MAX_FP_REGS];     // d0-d7
+};
+
+struct asSARM64Ret
+{
+	asQWORD x1;
+	asQWORD d[4];                      // d0-d3
+};
+
+// Loads the argument registers, copies the stack arguments, and calls the
+// function. Returns x0; x1 and d0-d3 are stored in *ret.
+extern "C" asQWORD asARM64_CallFunction(const asSARM64Regs *regs, const void *stackArgs, asQWORD stackSize, asFUNCTION_t func, asSARM64Ret *ret);
+
+__asm__(
+	".text\n"
+	".p2align 2\n"
+#ifdef __APPLE__
+	".globl _asARM64_CallFunction\n"
+	".private_extern _asARM64_CallFunction\n"
+	"_asARM64_CallFunction:\n"
+#else
+	".globl asARM64_CallFunction\n"
+	".hidden asARM64_CallFunction\n"
+	".type asARM64_CallFunction, %function\n"
+	"asARM64_CallFunction:\n"
+#endif
+	"  stp x29, x30, [sp, #-48]!\n"
+	"  mov x29, sp\n"
+	"  stp x19, x20, [sp, #16]\n"
+	"  str x21, [sp, #32]\n"
+	"  mov x19, x4\n"               // x19 = ret
+	"  mov x20, x3\n"               // x20 = func
+	"  mov x21, x0\n"               // x21 = regs
+	// reserve the (16 byte aligned) stack area and copy the stack arguments
+	"  sub sp, sp, x2\n"
+	"  mov x9, #0\n"
+	"1:\n"
+	"  cmp x9, x2\n"
+	"  b.hs 2f\n"
+	"  ldr x10, [x1, x9]\n"
+	"  str x10, [sp, x9]\n"
+	"  add x9, x9, #8\n"
+	"  b 1b\n"
+	"2:\n"
+	"  ldp d0, d1, [x21, #72]\n"
+	"  ldp d2, d3, [x21, #88]\n"
+	"  ldp d4, d5, [x21, #104]\n"
+	"  ldp d6, d7, [x21, #120]\n"
+	"  ldp x0, x1, [x21, #0]\n"
+	"  ldp x2, x3, [x21, #16]\n"
+	"  ldp x4, x5, [x21, #32]\n"
+	"  ldp x6, x7, [x21, #48]\n"
+	"  ldr x8, [x21, #64]\n"
+	"  blr x20\n"
+	"  str x1, [x19, #0]\n"
+	"  stp d0, d1, [x19, #8]\n"
+	"  stp d2, d3, [x19, #24]\n"
+	"  mov sp, x29\n"
+	"  ldr x21, [sp, #32]\n"
+	"  ldp x19, x20, [sp, #16]\n"
+	"  ldp x29, x30, [sp], #48\n"
+	"  ret\n"
+);
+
+class asCARM64ArgPacker
+{
+public:
+	asCARM64ArgPacker() : numGP(0), numFP(0), stackSize(0), overflow(false)
+	{
+		memset(&regs, 0, sizeof(regs));
+		memset(stack, 0, sizeof(stack));
+	}
+
+	// An integer class value of 'size' bytes (already extended to 64 bits)
+	void AddInt(asQWORD value, int size)
+	{
+		if( numGP < ARM64_MAX_GP_REGS )
+			regs.gp[numGP++] = value;
+		else
+			AddToStack(&value, size);
+	}
+
+	// A float (size 4) or double (size 8), as raw bits
+	void AddFloat(asQWORD bits, int size)
+	{
+		if( numFP < ARM64_MAX_FP_REGS )
+			regs.fp[numFP++] = bits;
+		else
+			AddToStack(&bits, size);
+	}
+
+	// A small composite of integer members, passed in up to 2 registers
+	void AddIntComposite(const void *data, int size)
+	{
+		int numRegs = (size + 7) / 8;
+		asQWORD v[2] = {0, 0};
+		memcpy(v, data, size);
+		if( numGP + numRegs <= ARM64_MAX_GP_REGS )
+		{
+			for( int n = 0; n < numRegs; n++ )
+				regs.gp[numGP++] = v[n];
+		}
+		else
+		{
+			// Once a composite doesn't fit, no more integer registers are used
+			numGP = ARM64_MAX_GP_REGS;
+			AlignStack(size > 8 ? 8 : 8);
+			AddRawToStack(v, numRegs * 8);
+		}
+	}
+
+	// A homogeneous aggregate of floats, one float per register
+	void AddFloatComposite(const float *data, int count)
+	{
+		if( numFP + count <= ARM64_MAX_FP_REGS )
+		{
+			for( int n = 0; n < count; n++ )
+			{
+				asQWORD bits = 0;
+				memcpy(&bits, &data[n], sizeof(float));
+				regs.fp[numFP++] = bits;
+			}
+		}
+		else
+		{
+			numFP = ARM64_MAX_FP_REGS;
+			AlignStack(4);
+			AddRawToStack(data, count * sizeof(float));
+		}
+	}
+
+	void SetIndirectResult(void *ptr) { regs.gp[ARM64_MAX_GP_REGS] = (asPWORD)ptr; }
+
+	asQWORD Call(asFUNCTION_t func, asSARM64Ret *ret)
+	{
+		asQWORD size = (stackSize + 15) & ~asQWORD(15);
+		return asARM64_CallFunction(&regs, stack, size, func, ret);
+	}
+
+	bool overflow;
+
+protected:
+	void AlignStack(int align)
+	{
+		stackSize = (stackSize + align - 1) & ~(align - 1);
+	}
+
+	void AddRawToStack(const void *data, int size)
+	{
+		if( stackSize + size > ARM64_MAX_STACK )
+		{
+			overflow = true;
+			return;
+		}
+		memcpy(stack + stackSize, data, size);
+		stackSize += size;
+	}
+
+	void AddToStack(const void *value, int size)
+	{
+		// Apple arm64: stack arguments use their natural size and alignment
+		AlignStack(size);
+		AddRawToStack(value, size); // little endian, so the low bytes come first
+	}
+
+	asSARM64Regs regs;
+	int          numGP;
+	int          numFP;
+	int          stackSize;
+	asBYTE       stack[ARM64_MAX_STACK];
+};
+
+
+// Reads a primitive of 'size' bytes and extends it to 64 bits
+static asQWORD ReadExtended(const asDWORD *src, int size, bool isSigned)
+{
+	switch( size )
+	{
+	case 1: return isSigned ? asQWORD(asINT64(*(const signed char*)src)) : asQWORD(*(const asBYTE*)src);
+	case 2: return isSigned ? asQWORD(asINT64(*(const short*)src)) : asQWORD(*(const asWORD*)src);
+	case 4: return isSigned ? asQWORD(asINT64(*(const int*)src)) : asQWORD(*(const asDWORD*)src);
+	default:
+		{
+			asQWORD v;
+			memcpy(&v, src, sizeof(v));
+			return v;
+		}
+	}
+}
+
+int CallSystemFunction(int id, asCContext *context, void *objectPointer)
+{
+	asCScriptEngine            *engine   = context->engine;
+	asCScriptFunction          *descr    = engine->scriptFunctions[id];
+	asSSystemFunctionInterface *sysFunc  = descr->sysFuncIntf;
+	int                         callConv = sysFunc->callConv;
+	asFUNCTION_t                func     = (asFUNCTION_t)sysFunc->func;
+	int                         popSize  = sysFunc->paramSize;
+	asDWORD                    *args     = context->regs.stackPointer;
+	void                       *retPointer = 0;
+	void                       *obj      = 0;
+
+	if( callConv == ICC_GENERIC_FUNC || callConv == ICC_GENERIC_METHOD )
+		return context->CallGeneric(id, objectPointer);
+
+	context->regs.objectType = descr->returnType.GetObjectType();
+	if( descr->returnType.IsObject() && !descr->returnType.IsReference() && !descr->returnType.IsObjectHandle() )
+	{
+		// Allocate the memory for the returned object
+		retPointer = engine->CallAlloc(descr->returnType.GetObjectType());
+	}
+
+	if( callConv >= ICC_THISCALL )
+	{
+		if( objectPointer )
+			obj = objectPointer;
+		else
+		{
+			// The object pointer is the first value on the context stack
+			popSize += AS_PTR_SIZE;
+			obj = (void*)*(asPWORD*)args;
+			args += AS_PTR_SIZE;
+			if( !obj )
+			{
+				context->SetInternalException(TXT_NULL_POINTER_ACCESS);
+				if( retPointer )
+					engine->CallFree(retPointer);
+				return 0;
+			}
+
+			// Add the base offset for multiple inheritance (shifted one bit
+			// left by the ARM C++ ABI, see DetectCallingConvention)
+			obj = (void*)(asPWORD(obj) + (sysFunc->baseOffset >> 1));
+		}
+	}
+
+	asCARM64ArgPacker packer;
+
+	// A return in memory is made via x8, so the calling convention is
+	// otherwise the same as when returning in registers
+	if( sysFunc->hostReturnInMemory )
+		packer.SetIndirectResult(retPointer);
+
+	if( obj && callConv == ICC_VIRTUAL_THISCALL )
+	{
+		// With the ARM C++ ABI the function pointer holds the vtable offset in bytes
+		asFUNCTION_t *vftable = *((asFUNCTION_t**)obj);
+		func = vftable[asPWORD(func) >> 3];
+	}
+
+	if( callConv == ICC_THISCALL || callConv == ICC_VIRTUAL_THISCALL || callConv == ICC_CDECL_OBJFIRST )
+		packer.AddInt((asPWORD)obj, sizeof(void*));
+
+	asDWORD *sp = args;
+	asUINT argumentCount = descr->parameterTypes.GetLength();
+	for( asUINT a = 0; a < argumentCount; ++a )
+	{
+		asCDataType &dt = descr->parameterTypes[a];
+
+		if( dt.GetTokenType() == ttQuestion )
+		{
+			// A variable type (?&) is passed as a pointer and a type id
+			packer.AddInt(ReadExtended(sp, sizeof(void*), false), sizeof(void*));
+			packer.AddInt(ReadExtended(sp + AS_PTR_SIZE, sizeof(int), true), sizeof(int));
+			sp += AS_PTR_SIZE + 1;
+		}
+		else if( dt.IsReference() || dt.IsObjectHandle() )
+		{
+			packer.AddInt(ReadExtended(sp, sizeof(void*), false), sizeof(void*));
+			sp += AS_PTR_SIZE;
+		}
+		else if( dt.IsObject() )
+		{
+			// An object passed by value: the script engine has allocated a
+			// copy and pushed its address. PrepareSystemFunction only allows
+			// complex objects (SPLIT_OBJS_BY_MEMBER_TYPES), which the ABI
+			// passes as a pointer to a copy owned by the caller -- freed below.
+			packer.AddInt(ReadExtended(sp, sizeof(void*), false), sizeof(void*));
+			sp += AS_PTR_SIZE;
+		}
+		else if( dt.IsFloatType() )
+		{
+			packer.AddFloat(ReadExtended(sp, sizeof(float), false), sizeof(float));
+			sp++;
+		}
+		else if( dt.IsDoubleType() )
+		{
+			packer.AddFloat(ReadExtended(sp, sizeof(double), false), sizeof(double));
+			sp += 2;
+		}
+		else
+		{
+			// Integers, bools and enums. Values narrower than 32 bits must be extended by the caller.
+			int size = dt.GetSizeInMemoryBytes();
+			bool isSigned = dt.IsIntegerType();
+			packer.AddInt(ReadExtended(sp, size, isSigned), size);
+			sp += dt.GetSizeOnStackDWords();
+		}
+	}
+
+	if( callConv == ICC_CDECL_OBJLAST )
+		packer.AddInt((asPWORD)obj, sizeof(void*));
+
+	if( packer.overflow )
+	{
+		context->SetInternalException(TXT_INVALID_CALLING_CONVENTION);
+		if( retPointer )
+			engine->CallFree(retPointer);
+		return 0;
+	}
+
+	asSARM64Ret ret;
+	context->isCallingSystemFunction = true;
+	asQWORD retQW = packer.Call(func, &ret);
+	context->isCallingSystemFunction = false;
+	asQWORD retQW2 = ret.x1;
+
+	if( sysFunc->takesObjByVal )
+	{
+		// Free the copies of the objects passed by value
+		sp = args;
+		for( asUINT n = 0; n < argumentCount; n++ )
+		{
+			asCDataType &dt = descr->parameterTypes[n];
+			if( dt.IsObject() && !dt.IsReference() && !dt.IsObjectHandle() )
+			{
+				void *copy = (void*)*(asPWORD*)sp;
+				asSTypeBehaviour *beh = &dt.GetObjectType()->beh;
+				if( beh->destruct )
+					engine->CallObjectMethod(copy, beh->destruct);
+				engine->CallFree(copy);
+				sp += AS_PTR_SIZE;
+			}
+			else if( dt.GetTokenType() == ttQuestion )
+				sp += AS_PTR_SIZE + 1;
+			else
+				sp += dt.GetSizeOnStackDWords();
+		}
+	}
+
+	// Store the returned value
+	if( descr->returnType.IsObject() && !descr->returnType.IsReference() )
+	{
+		if( descr->returnType.IsObjectHandle() )
+		{
+			context->regs.objectRegister = (void*)(asPWORD)retQW;
+
+			if( sysFunc->returnAutoHandle && context->regs.objectRegister )
+				engine->CallObjectMethod(context->regs.objectRegister, descr->returnType.GetObjectType()->beh.addref);
+		}
+		else
+		{
+			if( !sysFunc->hostReturnInMemory )
+			{
+				// Returned in registers: x0/x1, or d0 for an asOBJ_APP_FLOAT type
+				if( sysFunc->hostReturnFloat )
+				{
+					if( sysFunc->hostReturnSize == 1 )
+						*(asDWORD*)retPointer = (asDWORD)ret.d[0];
+					else
+						*(asQWORD*)retPointer = ret.d[0];
+				}
+				else if( sysFunc->hostReturnSize == 1 )
+					*(asDWORD*)retPointer = (asDWORD)retQW;
+				else if( sysFunc->hostReturnSize == 2 )
+					*(asQWORD*)retPointer = retQW;
+				else if( sysFunc->hostReturnSize == 3 )
+				{
+					*(asQWORD*)retPointer = retQW;
+					*(((asDWORD*)retPointer) + 2) = (asDWORD)retQW2;
+				}
+				else
+				{
+					*(asQWORD*)retPointer = retQW;
+					*(((asQWORD*)retPointer) + 1) = retQW2;
+				}
+			}
+
+			// Store the object in the register
+			context->regs.objectRegister = retPointer;
+		}
+	}
+	else
+	{
+		// Store the value in the value register
+		if( sysFunc->hostReturnFloat )
+		{
+			if( sysFunc->hostReturnSize == 1 )
+				*(asDWORD*)&context->regs.valueRegister = (asDWORD)ret.d[0];
+			else
+				context->regs.valueRegister = ret.d[0];
+		}
+		else if( sysFunc->hostReturnSize == 1 )
+			*(asDWORD*)&context->regs.valueRegister = (asDWORD)retQW;
+		else
+			context->regs.valueRegister = retQW;
+	}
+
+	if( sysFunc->hasAutoHandles )
+	{
+		// Release the handles the function received with auto handles
+		int spos = 0;
+		for( asUINT n = 0; n < argumentCount; n++ )
+		{
+			asCDataType &dt = descr->parameterTypes[n];
+			if( sysFunc->paramAutoHandles[n] && *(asPWORD*)&args[spos] != 0 )
+			{
+				engine->CallObjectMethod((void*)*(asPWORD*)&args[spos], dt.GetObjectType()->beh.release);
+				*(asPWORD*)&args[spos] = 0;
+			}
+
+			if( dt.IsObject() && !dt.IsObjectHandle() && !dt.IsReference() )
+				spos += AS_PTR_SIZE;
+			else if( dt.GetTokenType() == ttQuestion )
+				spos += AS_PTR_SIZE + 1;
+			else
+				spos += dt.GetSizeOnStackDWords();
+		}
+	}
+
+	return popSize;
+}
+
+END_AS_NAMESPACE
+
+#endif // AS_ARM64
+#endif // AS_MAX_PORTABILITY
