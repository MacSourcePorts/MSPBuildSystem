+#if defined(__APPLE__)
+//----------------------------------------------------------------------------
+// macOS: the game data lives in ~/Library/Application Support/civctp2,
+// laid out like the GOG/CD install folder:
+//
+//   ctp2_data/      (required, from the original game)
+//   Scenarios/      (required, from the original game)
+//   ctp2_program/   (optional; its ctp/music folder holds the music)
+//
+// The game runs from ctp2_program/ctp, where it keeps its saves, logs and
+// settings. The app bundle supplies the executable's own runtime files
+// (civpaths.txt etc.), the map plugins, and the Apolyton ctp2_data and
+// Scenarios changes, which take priority over the original files.
+//----------------------------------------------------------------------------
+#include <sys/stat.h>
+#include <string>
+
+namespace
+{
+	std::string macos_ResourcePath(char const * a_Name)
+	{
+		std::string path;
+		char * base = SDL_GetBasePath(); // .app/Contents/Resources/
+		if (base)
+		{
+			path = base;
+			SDL_free(base);
+		}
+		return path + a_Name;
+	}
+
+	bool macos_IsDir(std::string const & a_Path)
+	{
+		struct stat st;
+		return (stat(a_Path.c_str(), &st) == 0) && S_ISDIR(st.st_mode);
+	}
+
+	bool macos_IsFile(std::string const & a_Path)
+	{
+		struct stat st;
+		return (stat(a_Path.c_str(), &st) == 0) && S_ISREG(st.st_mode);
+	}
+
+	void macos_MakeDirs(std::string const & a_Path)
+	{
+		for (size_t i = 1; i <= a_Path.size(); ++i)
+		{
+			if (i == a_Path.size() || a_Path[i] == '/')
+			{
+				mkdir(a_Path.substr(0, i).c_str(), 0755);
+			}
+		}
+	}
+
+	bool macos_RunDitto(std::string const & a_From, std::string const & a_To)
+	{
+		std::string cmd = "/usr/bin/ditto '" + a_From + "' '" + a_To + "'";
+		return system(cmd.c_str()) == 0;
+	}
+}
+
+std::string macos_GetUserDir()
+{
+	char const * home = getenv("HOME");
+	return std::string(home ? home : "") + "/Library/Application Support/civctp2";
+}
+
+bool macos_SetupUserDir()
+{
+	std::string const root = macos_GetUserDir();
+
+	if (!macos_IsDir(root + "/ctp2_data/default") || !macos_IsDir(root + "/Scenarios"))
+	{
+		macos_MakeDirs(root);
+		std::string message =
+			"Call to Power II needs the data files from the original game.\n\n"
+			"Copy the ctp2_data and Scenarios folders (and, for music, the "
+			"ctp2_program folder) from your Call to Power II installation "
+			"(GOG or CD) into:\n\n" + root;
+		SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Call to Power II",
+		                         message.c_str(), NULL);
+		system(("/usr/bin/open '" + root + "'").c_str());
+		return false;
+	}
+
+	// The working directory, as on the original install
+	std::string const work = root + "/ctp2_program/ctp";
+	macos_MakeDirs(work);
+	if (chdir(work.c_str()) != 0)
+	{
+		return false;
+	}
+
+	// Runtime files the game expects next to its executable
+	char const * files[] = { "civpaths.txt", "appstr.txt", "anet.inf", "bootserv.txt" };
+	for (size_t i = 0; i < sizeof(files) / sizeof(files[0]); ++i)
+	{
+		std::string const from = macos_ResourcePath("ctp2_code/ctp/") + files[i];
+		if (!macos_IsFile(files[i]) && macos_IsFile(from))
+		{
+			macos_RunDitto(from, files[i]);
+		}
+	}
+
+	// The Apolyton scenario changes only hold the changed files, so merge
+	// them into the original scenarios, once per app version.
+	std::string const scenarios = macos_ResourcePath("Scenarios");
+	std::string const stamp     = root + "/Scenarios/.msp_scenarios_version";
+	std::string version; // the bundled folder's date changes with each build
+	{
+		struct stat st;
+		if (stat(scenarios.c_str(), &st) == 0)
+		{
+			version = std::to_string(static_cast<long long>(st.st_mtime));
+		}
+	}
+	if (macos_IsDir(scenarios))
+	{
+		std::string installed;
+		if (FILE * f = fopen(stamp.c_str(), "r"))
+		{
+			char buf[64] = { 0 };
+			if (fgets(buf, sizeof(buf), f)) installed = buf;
+			fclose(f);
+		}
+		if (installed != version && macos_RunDitto(scenarios, root + "/Scenarios"))
+		{
+			if (FILE * f = fopen(stamp.c_str(), "w"))
+			{
+				fputs(version.c_str(), f);
+				fclose(f);
+			}
+		}
+	}
+
+	return true;
+}
