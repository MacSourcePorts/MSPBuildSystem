 void find_home_dir(void) {
 	if (found_home_dir) return;
 	const char* home_path = getenv("HOME");
+#ifdef __APPLE__
+	// MSP: ~/Library/Application Support/PrinceOfPersia holds the settings,
+	// saves, screenshots, replays and mods, and files placed there (SDLPoP.ini,
+	// data/...) are found before the ones bundled in Contents/Resources.
+	char sub_dir[POP_MAX_PATH];
+	snprintf_check(home_dir, POP_MAX_PATH - 1, "%s/Library/Application Support", home_path);
+	mkdir(home_dir, 0755);
+	snprintf_check(home_dir, POP_MAX_PATH - 1, "%s/Library/Application Support/%s", home_path, MSP_APP_SUPPORT_NAME);
+	mkdir(home_dir, 0755);
+	const char* sub_dirs[] = {"mods", "replays", "screenshots"};
+	for (int i = 0; i < 3; i++) {
+		snprintf_check(sub_dir, sizeof(sub_dir), "%s/%s", home_dir, sub_dirs[i]);
+		mkdir(sub_dir, 0755);
+	}
+#else
 	snprintf_check(home_dir, POP_MAX_PATH - 1, "%s/.%s", home_path, POP_DIR_NAME);
+#endif
 	if(file_exists(home_dir))
 		found_home_dir = true;
 }
