diff --git a/Aquaria/Main.cpp b/Aquaria/Main.cpp
index 9af0c15..251ab83 100644
--- a/Aquaria/Main.cpp
+++ b/Aquaria/Main.cpp
@@ -26,6 +26,31 @@ Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA  02111-1307, USA.
 	#include <shellapi.h>
 #endif
 
+#ifdef BBGE_BUILD_MACOSX
+	#include <CoreFoundation/CoreFoundation.h>
+	#include <limits.h>
+	#include <sys/stat.h>
+
+// The app bundle's Resources folder, which holds the updated data files
+// (the repo's "files" folder, plus the updated mod scripts in files/_mods)
+// that are used on top of the original game's data.
+static std::string MacBundleResourcesDir()
+{
+	std::string ret;
+	CFBundleRef mainBundle = CFBundleGetMainBundle();
+	if (!mainBundle)
+		return ret;
+	CFURLRef url = CFBundleCopyResourcesDirectoryURL(mainBundle);
+	if (!url)
+		return ret;
+	char path[PATH_MAX];
+	if (CFURLGetFileSystemRepresentation(url, TRUE, (UInt8 *)path, PATH_MAX))
+		ret = path;
+	CFRelease(url);
+	return ret;
+}
+#endif
+
 
 static void MakeRan(void)
 {
@@ -101,6 +126,42 @@ static void CheckConfig(void)
 #ifdef AQUARIA_EXTRA_DATA_DIR
 		extraDataDir = AQUARIA_EXTRA_DATA_DIR;
 #endif
+#if defined(BBGE_BUILD_MACOSX) && !defined(AQUARIA_DEFAULT_DATA_DIR)
+		// The original game's data goes in ~/Library/Application Support/Aquaria
+		// (also where saves and settings are kept)
+		if (!envPath)
+		{
+			const char *home = getenv("HOME");
+			if (home)
+				dsqParam = std::string(home) + "/Library/Application Support/Aquaria";
+		}
+#endif
+#ifdef BBGE_BUILD_MACOSX
+		// Without the original game's data there's nothing to run: say where it goes
+		if (!dsqParam.empty())
+		{
+			struct stat st;
+			if (stat((dsqParam + "/data").c_str(), &st) != 0 || stat((dsqParam + "/gfx").c_str(), &st) != 0)
+			{
+				mkdir(dsqParam.c_str(), 0755);
+				const std::string msg =
+					"Aquaria needs the data files from the original game (for example the GOG, "
+					"Humble Bundle or Steam version).\n\n"
+					"Copy everything from the game's folder (data, gfx, mus, scripts, sfx, vox, _mods, ...) into:\n\n"
+					+ dsqParam;
+				SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Game data not found", msg.c_str(), NULL);
+				return 1;
+			}
+		}
+#endif
+#if defined(BBGE_BUILD_MACOSX) && !defined(AQUARIA_EXTRA_DATA_DIR)
+		{
+			const std::string res = MacBundleResourcesDir();
+			struct stat st;
+			if (!res.empty() && stat((res + "/files").c_str(), &st) == 0 && S_ISDIR(st.st_mode))
+				extraDataDir = res + "/files";
+		}
+#endif
 
 #endif
 
