diff --git a/src/game/PreferencesPath.cpp b/src/game/PreferencesPath.cpp
index bbc889cd..05ef69ba 100644
--- a/src/game/PreferencesPath.cpp
+++ b/src/game/PreferencesPath.cpp
@@ -46,4 +46,36 @@ std::optional<std::filesystem::path> file(const char *fileName)
     return *dir / fileName;
 }
 
+bool runningFromAppBundle()
+{
+#ifdef __APPLE__
+    // SDL_GetBasePath is Contents/Resources/ for an app bundle, the executable's directory otherwise
+    const char *basePath = SDL_GetBasePath();
+    return basePath != nullptr && std::string_view(basePath).ends_with(".app/Contents/Resources/");
+#else
+    return false;
+#endif
+}
+
+void enterAppBundleResources()
+{
+    if (!runningFromAppBundle()) return;
+    std::error_code ec;
+    std::filesystem::current_path(SDL_GetBasePath(), ec);
+
+    // the music is MIDI, which FluidSynth needs a soundfont for: use the bundled one unless the player set their own
+    const std::string soundfont = std::string(SDL_GetBasePath()) + "GeneralUser-GS.sf2";
+    if (SDL_getenv("SDL_SOUNDFONTS") == nullptr && std::filesystem::exists(soundfont, ec)) {
+        SDL_SetEnvironmentVariable(SDL_GetEnvironment(), "SDL_SOUNDFONTS", soundfont.c_str(), false);
+    }
+}
+
+std::filesystem::path writableDirectory()
+{
+    if (runningFromAppBundle()) {
+        if (const auto dir = directory()) return *dir;
+    }
+    return ".";
+}
+
 }
diff --git a/src/game/PreferencesPath.hpp b/src/game/PreferencesPath.hpp
