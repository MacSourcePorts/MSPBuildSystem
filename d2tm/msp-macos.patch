 // directory() / fileName, or nullopt when there is no directory.
 std::optional<std::filesystem::path> file(const char *fileName);
 
+// True when running from a macOS .app bundle. The game data then lives in the bundle's
+// read-only Contents/Resources (made the working directory by enterAppBundleResources), and
+// everything the game writes goes to directory() instead.
+bool runningFromAppBundle();
+
+// When running from a macOS .app bundle, make Contents/Resources the working directory, and use the
+// bundled soundfont for the MIDI music unless SDL_SOUNDFONTS names another.
+void enterAppBundleResources();
+
+// Where the game writes files it would otherwise write into the working directory (log,
+// saved skirmish maps, custom music folders): directory() when running from an app bundle,
+// the working directory otherwise.
+std::filesystem::path writableDirectory();
+
 }
