+#ifdef __APPLE__
+// The configured CD path (by default ~/Library/Application Support/OpenApoc/cd.iso),
+// or if that doesn't exist, the other names the CD image goes by in that folder:
+// GOG ships it as XCOM.cue + XCOM.BIN (in a "CD" subfolder), Steam as cd.iso
+static UString resolveCDPath()
+{
+	const UString configured = Options::cdPathOption.get();
+	std::error_code ec;
+	if (fs::exists(configured, ec))
+		return configured;
+
+	const fs::path dir = fs::path(configured).parent_path();
+	for (const fs::path &candidate :
+	     {dir / "cd.iso", dir / "XCOM.cue", dir / "xcom.cue", dir / "CD" / "XCOM.cue",
+	      dir / "CD" / "xcom.cue", fs::path("./data/cd.iso")})
+	{
+		if (fs::exists(candidate, ec))
+			return candidate.string();
+	}
+	// any other cue sheet in the folder
+	for (auto it = fs::directory_iterator(dir, ec); !ec && it != fs::directory_iterator();
+	     it.increment(ec))
+	{
+		auto ext = it->path().extension().string();
+		if (ext == ".cue" || ext == ".CUE")
+			return it->path().string();
+	}
+	return configured;
+}
+UString Framework::getCDPath() const { return resolveCDPath(); }
+#else
 UString Framework::getCDPath() const { return Options::cdPathOption.get(); }
+#endif
 
