+#include "ogvmovie.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+#include <SDL3/SDL_audio.h>
+#include <ogg/ogg.h>
+#include <theora/theoradec.h>
+#include <vorbis/codec.h>
+
+#include "log.h"
+#include "pstypes.h"
+
+struct OgvDecoder::State {
+  FILE *fp = nullptr;
+  ogg_sync_state oy{};
+  ogg_stream_state to{}, vo{};
+  th_info ti{};
+  th_comment tc{};
+  th_setup_info *ts = nullptr;
+  th_dec_ctx *td = nullptr;
+  vorbis_info vi{};
+  vorbis_comment vc{};
+  vorbis_dsp_state vd{};
+  vorbis_block vb{};
+  int theora_p = 0, vorbis_p = 0;
+  bool vorbis_ready = false;
+  bool eof = false;
+  SDL_AudioStream *audio = nullptr;
+  uint64_t audio_samples = 0;
+  std::vector<float> pcm;
+};
+
+OgvDecoder::OgvDecoder() = default;
+OgvDecoder::~OgvDecoder() { Close(); }
+
+void OgvDecoder::Close() {
+  if (!m)
+    return;
+  if (m->audio) {
+    SDL_DestroyAudioStream(m->audio);
+  }
+  if (m->td)
+    th_decode_free(m->td);
+  if (m->ts)
+    th_setup_free(m->ts);
+  if (m->theora_p)
+    ogg_stream_clear(&m->to);
+  th_comment_clear(&m->tc);
+  th_info_clear(&m->ti);
+  if (m->vorbis_ready) {
+    vorbis_block_clear(&m->vb);
+    vorbis_dsp_clear(&m->vd);
+  }
+  if (m->vorbis_p)
+    ogg_stream_clear(&m->vo);
+  vorbis_comment_clear(&m->vc);
+  vorbis_info_clear(&m->vi);
+  ogg_sync_clear(&m->oy);
+  if (m->fp)
+    fclose(m->fp);
+  m.reset();
+}
+
+// Reads the next page from the file and hands it to the streams.
+bool OgvDecoder::ReadPage() {
+  ogg_page og;
+  while (ogg_sync_pageout(&m->oy, &og) <= 0) {
+    char *buffer = ogg_sync_buffer(&m->oy, 4096);
+    size_t bytes = fread(buffer, 1, 4096, m->fp);
+    if (bytes == 0) {
+      m->eof = true;
+      return false;
+    }
+    ogg_sync_wrote(&m->oy, (long)bytes);
+  }
+  if (m->theora_p)
+    ogg_stream_pagein(&m->to, &og);
+  if (m->vorbis_p)
+    ogg_stream_pagein(&m->vo, &og);
+  return true;
+}
+
+bool OgvDecoder::Open(const std::filesystem::path &path, bool play_audio) {
+  Close();
+  m = std::make_unique<State>();
+  m_path = path;
+  m_play_audio = play_audio;
+  m_frame_time = 0.0;
+  m_frame_number = 0;
+
+  m->fp = fopen(PATH_TO_CSTR(path), "rb");
+  if (!m->fp) {
+    m.reset();
+    return false;
+  }
+  ogg_sync_init(&m->oy);
+  th_info_init(&m->ti);
+  th_comment_init(&m->tc);
+  vorbis_info_init(&m->vi);
+  vorbis_comment_init(&m->vc);
+
+  // Find the Theora and Vorbis streams among the beginning-of-stream pages
+  ogg_page og;
+  ogg_packet op;
+  bool headers_done = false;
+  while (!headers_done) {
+    char *buffer = ogg_sync_buffer(&m->oy, 4096);
+    size_t bytes = fread(buffer, 1, 4096, m->fp);
+    if (bytes == 0)
+      break;
+    ogg_sync_wrote(&m->oy, (long)bytes);
+    while (ogg_sync_pageout(&m->oy, &og) > 0) {
+      if (!ogg_page_bos(&og)) {
+        if (m->theora_p)
+          ogg_stream_pagein(&m->to, &og);
+        if (m->vorbis_p)
+          ogg_stream_pagein(&m->vo, &og);
+        headers_done = true;
+        break;
+      }
+      ogg_stream_state test;
+      ogg_stream_init(&test, ogg_page_serialno(&og));
+      ogg_stream_pagein(&test, &og);
+      ogg_stream_packetout(&test, &op);
+      if (!m->theora_p && th_decode_headerin(&m->ti, &m->tc, &m->ts, &op) >= 0) {
+        memcpy(&m->to, &test, sizeof(test));
+        m->theora_p = 1;
+      } else if (!m->vorbis_p && vorbis_synthesis_headerin(&m->vi, &m->vc, &op) >= 0) {
+        memcpy(&m->vo, &test, sizeof(test));
+        m->vorbis_p = 1;
+      } else {
+        ogg_stream_clear(&test);
+      }
+    }
+  }
+
+  if (!m->theora_p) {
+    LOG_ERROR << "MOVIE: no Theora video in " << path;
+    Close();
+    return false;
+  }
+
+  // The remaining header packets
+  while ((m->theora_p && m->theora_p < 3) || (m->vorbis_p && m->vorbis_p < 3)) {
+    int ret;
+    while (m->theora_p && m->theora_p < 3 && (ret = ogg_stream_packetout(&m->to, &op)) != 0) {
+      if (ret < 0 || th_decode_headerin(&m->ti, &m->tc, &m->ts, &op) <= 0) {
+        LOG_ERROR << "MOVIE: bad Theora headers in " << path;
+        Close();
+        return false;
+      }
+      m->theora_p++;
+    }
+    while (m->vorbis_p && m->vorbis_p < 3 && (ret = ogg_stream_packetout(&m->vo, &op)) != 0) {
+      if (ret < 0 || vorbis_synthesis_headerin(&m->vi, &m->vc, &op) != 0) {
+        LOG_ERROR << "MOVIE: bad Vorbis headers in " << path;
+        Close();
+        return false;
+      }
+      m->vorbis_p++;
+    }
+    if (ogg_sync_pageout(&m->oy, &og) > 0) {
+      if (m->theora_p)
+        ogg_stream_pagein(&m->to, &og);
+      if (m->vorbis_p)
+        ogg_stream_pagein(&m->vo, &og);
+    } else {
+      char *buffer = ogg_sync_buffer(&m->oy, 4096);
+      size_t bytes = fread(buffer, 1, 4096, m->fp);
+      if (bytes == 0) {
+        LOG_ERROR << "MOVIE: end of file while reading headers of " << path;
+        Close();
+        return false;
+      }
+      ogg_sync_wrote(&m->oy, (long)bytes);
+    }
+  }
+
+  m->td = th_decode_alloc(&m->ti, m->ts);
+  if (!m->td) {
+    Close();
+    return false;
+  }
+  m_width = (int)m->ti.pic_width;
+  m_height = (int)m->ti.pic_height;
+  m_pixels.assign((size_t)m_width * m_height, 0);
+  if (m->ti.fps_numerator > 0 && m->ti.fps_denominator > 0)
+    m_frame_duration = (double)m->ti.fps_denominator / (double)m->ti.fps_numerator;
+
+  if (m->vorbis_p) {
+    if (m_play_audio) {
+      vorbis_synthesis_init(&m->vd, &m->vi);
+      vorbis_block_init(&m->vd, &m->vb);
+      m->vorbis_ready = true;
+
+      SDL_AudioSpec spec{};
+      spec.format = SDL_AUDIO_F32;
+      spec.channels = m->vi.channels;
+      spec.freq = (int)m->vi.rate;
+      m->audio = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, nullptr, nullptr);
+      if (!m->audio) {
+        LOG_WARNING << "MOVIE: unable to open audio: " << SDL_GetError();
+      }
+    } else {
+      // not playing the audio, so stop collecting its pages
+      ogg_stream_clear(&m->vo);
+      m->vorbis_p = 0;
+    }
+  }
+
+  return true;
+}
+
+bool OgvDecoder::Rewind() { return Open(m_path, m_play_audio); }
+
+bool OgvDecoder::NextFrame() {
+  if (!m)
+    return false;
+  ogg_packet op;
+  for (;;) {
+    if (ogg_stream_packetout(&m->to, &op) > 0) {
+      if (op.granulepos >= 0) {
+        th_decode_ctl(m->td, TH_DECCTL_SET_GRANPOS, &op.granulepos, sizeof(op.granulepos));
+      }
+      ogg_int64_t granulepos = 0;
+      int ret = th_decode_packetin(m->td, &op, &granulepos);
+      if (ret == 0 || ret == TH_DUPFRAME) {
+        m_frame_time = th_granule_time(m->td, granulepos);
+        if (ret == 0)
+          ConvertFrame();
+        m_frame_number++;
+        return true;
+      }
+      continue;
+    }
+    if (!ReadPage())
+      return false;
+  }
+}
+
+void OgvDecoder::ConvertFrame() {
+  th_ycbcr_buffer ycbcr;
+  th_decode_ycbcr_out(m->td, ycbcr);
+
+  const int hdec = !(m->ti.pixel_fmt & 1);
+  const int vdec = !(m->ti.pixel_fmt & 2);
+  const int px = (int)m->ti.pic_x, py = (int)m->ti.pic_y;
+
+  uint16_t *out = m_pixels.data();
+  for (int y = 0; y < m_height; y++) {
+    const uint8_t *yrow = ycbcr[0].data + (ptrdiff_t)(y + py) * ycbcr[0].stride;
+    const uint8_t *cbrow = ycbcr[1].data + (ptrdiff_t)((y + py) >> vdec) * ycbcr[1].stride;
+    const uint8_t *crrow = ycbcr[2].data + (ptrdiff_t)((y + py) >> vdec) * ycbcr[2].stride;
+    for (int x = 0; x < m_width; x++) {
+      int c = yrow[x + px] - 16;
+      int d = cbrow[(x + px) >> hdec] - 128;
+      int e = crrow[(x + px) >> hdec] - 128;
+      int r = std::clamp((298 * c + 409 * e + 128) >> 8, 0, 255);
+      int g = std::clamp((298 * c - 100 * d - 208 * e + 128) >> 8, 0, 255);
+      int b = std::clamp((298 * c + 516 * d + 128) >> 8, 0, 255);
+      *out++ = (uint16_t)(0x8000 | ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3));
+    }
+  }
+}
+
+void OgvDecoder::QueueAudio(double until) {
+  if (!m || !m->vorbis_ready || !m->audio)
+    return;
+  const int channels = m->vi.channels;
+  while ((double)m->audio_samples / (double)m->vi.rate < until) {
+    float **pcm;
+    int samples = vorbis_synthesis_pcmout(&m->vd, &pcm);
+    if (samples > 0) {
+      m->pcm.resize((size_t)samples * channels);
+      for (int i = 0; i < samples; i++) {
+        for (int ch = 0; ch < channels; ch++) {
+          m->pcm[(size_t)i * channels + ch] = pcm[ch][i];
+        }
+      }
+      SDL_PutAudioStreamData(m->audio, m->pcm.data(), (int)(m->pcm.size() * sizeof(float)));
+      vorbis_synthesis_read(&m->vd, samples);
+      m->audio_samples += samples;
+      continue;
+    }
+    ogg_packet op;
+    if (ogg_stream_packetout(&m->vo, &op) > 0) {
+      if (vorbis_synthesis(&m->vb, &op) == 0)
+        vorbis_synthesis_blockin(&m->vd, &m->vb);
+      continue;
+    }
+    if (!ReadPage())
+      break;
+  }
+}
+
+void OgvDecoder::StartAudio() {
+  if (m && m->audio)
+    SDL_ResumeAudioStreamDevice(m->audio);
+}
+
+double OgvDecoder::AudioPending() const {
+  if (!m || !m->audio)
+    return 0.0;
+  int queued = SDL_GetAudioStreamQueued(m->audio);
+  if (queued <= 0)
+    return 0.0;
+  return (double)queued / (sizeof(float) * m->vi.channels * (double)m->vi.rate);
+}
