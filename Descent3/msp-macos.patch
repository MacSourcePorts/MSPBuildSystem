+
+// Ogg Theora/Vorbis movie decoding. The Steam release of Descent 3 ships its
+// movies as .ogv files instead of Interplay .mve files.
+
+#ifndef OGVMOVIE_H_
+#define OGVMOVIE_H_
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <vector>
+
+class OgvDecoder {
+public:
+  OgvDecoder();
+  ~OgvDecoder();
+  OgvDecoder(const OgvDecoder &) = delete;
+  OgvDecoder &operator=(const OgvDecoder &) = delete;
+
+  // Opens a movie. With play_audio, its Vorbis track (if any) is sent to the
+  // default audio device, paused until StartAudio().
+  bool Open(const std::filesystem::path &path, bool play_audio);
+  void Close();
+  // Restarts the movie from its beginning.
+  bool Rewind();
+
+  // Decodes the next video frame into Pixels() (RGB 1-5-5-5, opaque).
+  // Returns false at the end of the stream.
+  bool NextFrame();
+
+  // Decodes and queues audio up to the given movie time, in seconds.
+  void QueueAudio(double until);
+  void StartAudio();
+  // Seconds of audio still waiting to be played.
+  double AudioPending() const;
+
+  int Width() const { return m_width; }
+  int Height() const { return m_height; }
+  const uint16_t *Pixels() const { return m_pixels.data(); }
+  double FrameTime() const { return m_frame_time; }
+  double FrameDuration() const { return m_frame_duration; }
+  uint32_t FrameNumber() const { return m_frame_number; }
+
+private:
+  struct State;
+  std::unique_ptr<State> m;
+  std::filesystem::path m_path;
+  bool m_play_audio = false;
+
+  int m_width = 0, m_height = 0;
+  std::vector<uint16_t> m_pixels;
+  double m_frame_time = 0.0;
+  double m_frame_duration = 1.0 / 30.0;
+  uint32_t m_frame_number = 0;
+
+  bool ReadPage();
+  void ConvertFrame();
+};
+
+#endif
