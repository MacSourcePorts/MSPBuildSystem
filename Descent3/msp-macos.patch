+
+int PlayOgvMovie(const std::filesystem::path &path, oeApplication *pApp) {
+  OgvDecoder decoder;
+  if (!decoder.Open(path, FindArg("-nosound") == 0)) {
+    LOG_ERROR << "MOVIE: Unable to open " << path;
+    return MVELIB_INIT_ERROR;
+  }
+
+  Movie_bm_handle = -1;
+  Movie_current_framenum = 0;
+  // center the movie on the 640x480 movie screen (the Steam movies are 640x320 or 640x480)
+  const int w = decoder.Width(), h = decoder.Height();
+  const int dstx = std::max(0, (640 - w) / 2);
+  const int dsty = std::max(0, (480 - h) / 2);
+
+  decoder.QueueAudio(0.5);
+  decoder.StartAudio();
+  const uint64_t start = SDL_GetTicksNS();
+
+  bool aborted = false;
+  while (!aborted && decoder.NextFrame()) {
+    const double frame_time = decoder.FrameTime();
+    decoder.QueueAudio(frame_time + 0.5);
+
+    // wait until it's time for this frame
+    while (SecondsSince(start) < frame_time) {
+      pApp->defer();
+      if (ddio_KeyInKey() == KEY_ESC) {
+        aborted = true;
+        break;
+      }
+      SDL_Delay(1);
+    }
+    if (aborted)
+      break;
+
+    // skip drawing frames we're already too late for
+    if (SecondsSince(start) > frame_time + 2 * decoder.FrameDuration())
+      continue;
+
+    CallbackShowFrame(const_cast<uint8_t *>(reinterpret_cast<const uint8_t *>(decoder.Pixels())), w, h, 0, 0, w, h,
+                      dstx, dsty, 1);
+    pApp->defer();
+    if (ddio_KeyInKey() == KEY_ESC)
+      aborted = true;
+  }
+
+  // let the rest of the soundtrack play out
+  if (!aborted) {
+    decoder.QueueAudio(1e9);
+    while (decoder.AudioPending() > 0.0) {
+      pApp->defer();
+      if (ddio_KeyInKey() == KEY_ESC)
+        break;
+      SDL_Delay(5);
+    }
+  }
+
+  if (Movie_bm_handle != -1) {
+    bm_FreeBitmap(Movie_bm_handle);
+    Movie_bm_handle = -1;
+  }
+
+  return aborted ? MVELIB_PLAYBACK_ABORTED : MVELIB_NOERROR;
+}
+
+intptr_t StartOgvSequence(const std::filesystem::path &path, bool looping) {
+  auto *seq = new OgvSequence;
+  if (!seq->decoder.Open(path, false)) {
+    LOG_WARNING << "MOVIE: Unable to open " << path;
+    delete seq;
+    return 0;
+  }
+  seq->looping = looping;
+  seq->start_ns = SDL_GetTicksNS();
+  Movie_bm_handle = -1;
+  rend_SetFrameBufferCopyState(true);
+
+  auto handle = reinterpret_cast<intptr_t>(seq);
+  Ogv_sequences.insert(handle);
+  return handle;
+}
+
+bool IsOgvSequence(intptr_t handle) { return Ogv_sequences.count(handle) != 0; }
+
+intptr_t OgvSequenceFrame(intptr_t handle, int *bm_handle) {
+  auto *seq = reinterpret_cast<OgvSequence *>(handle);
+  OgvDecoder &decoder = seq->decoder;
+
+  // catch up to the current time
+  bool decoded = false;
+  double elapsed = SecondsSince(seq->start_ns);
+  while (!seq->have_frame || decoder.FrameTime() + decoder.FrameDuration() <= elapsed) {
+    if (decoder.NextFrame()) {
+      seq->have_frame = true;
+      decoded = true;
+      continue;
+    }
+    // end of the movie
+    if (!seq->looping || !seq->have_frame || !decoder.Rewind()) {
+      return -1;
+    }
+    seq->start_ns = SDL_GetTicksNS();
+    seq->have_frame = false;
+    elapsed = 0.0;
+  }
+
+  if (decoded) {
+    int texW, texH;
+    BlitToMovieBitmap(const_cast<uint8_t *>(reinterpret_cast<const uint8_t *>(decoder.Pixels())), decoder.Width(),
+                      decoder.Height(), 1, false, texW, texH);
+  }
+  if (bm_handle) {
+    *bm_handle = Movie_bm_handle;
+  }
+  return handle;
+}
+
+void CloseOgvSequence(intptr_t handle) {
+  Ogv_sequences.erase(handle);
+  delete reinterpret_cast<OgvSequence *>(handle);
+
+  if (Movie_bm_handle != -1) {
+    bm_FreeBitmap(Movie_bm_handle);
+    Movie_bm_handle = -1;
+  }
+  rend_SetFrameBufferCopyState(false);
+}
