diff --git a/src/xr_3da/CMakeLists.txt b/src/xr_3da/CMakeLists.txt
index 2ea56a226..b050796b5 100644
--- a/src/xr_3da/CMakeLists.txt
+++ b/src/xr_3da/CMakeLists.txt
@@ -33,6 +33,11 @@ target_link_libraries(xr_3da
     xrGame
 )
 
+if (APPLE)
+    # MacSourcePorts: reads the MSPGameMode key from the bundle's Info.plist
+    target_link_libraries(xr_3da PRIVATE "-framework CoreFoundation")
+endif()
+
 set_target_properties(xr_3da PROPERTIES
     PREFIX ""
 )
diff --git a/src/xr_3da/entry_point.cpp b/src/xr_3da/entry_point.cpp
index 82d7da5d3..acfab9f01 100644
--- a/src/xr_3da/entry_point.cpp
+++ b/src/xr_3da/entry_point.cpp
@@ -11,6 +11,10 @@
 #include <getopt.h>
 #endif
 
+#if defined(XR_PLATFORM_APPLE)
+#include <CoreFoundation/CoreFoundation.h>
+#endif
+
 // Always request high performance GPU
 extern "C"
 {
@@ -86,9 +90,32 @@ int main(int argc, char *argv[])
     {
         char* commandLine = nullptr;
         int i;
+#if defined(XR_PLATFORM_APPLE)
+        // MacSourcePorts: one engine build ships as an app per game. The
+        // bundle's Info.plist MSPGameMode key (e.g. "cs") picks the game the
+        // way the -cs / -shoc / -cop flags do, unless one was given.
+        char gameModeArg[16] = {};
+        if (CFTypeRef gameMode = CFBundleGetValueForInfoDictionaryKey(
+                CFBundleGetMainBundle(), CFSTR("MSPGameMode")))
+        {
+            char mode[8] = {};
+            bool given = false;
+            for (i = 1; i < argc; ++i)
+                if (!strcmp(argv[i], "-cs") || !strcmp(argv[i], "-shoc") || !strcmp(argv[i], "-soc") ||
+                    !strcmp(argv[i], "-cop") || !strcmp(argv[i], "-unlock_game_mode"))
+                    given = true;
+            if (!given && CFGetTypeID(gameMode) == CFStringGetTypeID() &&
+                CFStringGetCString((CFStringRef)gameMode, mode, sizeof(mode), kCFStringEncodingUTF8) && *mode)
+                snprintf(gameModeArg, sizeof(gameModeArg), "-%s", mode);
+        }
+        if (argc > 1 || *gameModeArg)
+        {
+            size_t sum = 1 + strlen(gameModeArg) + 1;
+#else
         if(argc > 1)
         {
             size_t sum = 1;
+#endif
             for(i = 1; i < argc; ++i)
                 sum += strlen(argv[i]) + 1;
 
@@ -100,6 +127,13 @@ int main(int argc, char *argv[])
                 strcat(commandLine, argv[i]);
                 strcat(commandLine, " ");
             }
+#if defined(XR_PLATFORM_APPLE)
+            if (*gameModeArg)
+            {
+                strcat(commandLine, gameModeArg);
+                strcat(commandLine, " ");
+            }
+#endif
 
             result = entry_point(commandLine);
 
