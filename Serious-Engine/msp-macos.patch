--- a/Sources/Engine/Base/Unix/UnixFileSystem.cpp
+++ b/Sources/Engine/Base/Unix/UnixFileSystem.cpp
@@ -114,7 +114,13 @@ BOOL CFileSystem::IsDirectory(const char *fname)
 
 CUnixFileSystem::CUnixFileSystem(const char *argv0, const char *gamename)
 {
+#ifdef __APPLE__
+    // MacSourcePorts: no /proc on macOS. The app bundle's Resources folder,
+    // where the game libraries are, stands in for the executable's folder.
+    exePath = SDL_GetBasePath();
+#else
     exePath = readSymLink("/proc/self/exe");
+#endif
     userDir = SDL_GetPrefPath("Serious Engine", gamename);
 }
 
