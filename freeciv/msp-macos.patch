+#ifdef __APPLE__
+/************************************************************************//**
+  MSP: when running from inside a macOS app bundle
+  (Something.app/Contents/MacOS/executable), returns the absolute path of
+  that Contents/MacOS directory, otherwise NULL.
+****************************************************************************/
+const char *macos_bundle_exe_dir(void)
+{
+  static bool init = FALSE;
+  static bool in_bundle = FALSE;
+  static char dir[PATH_MAX];
+
+  if (!init) {
+    char raw[PATH_MAX];
+    uint32_t size = sizeof(raw);
+
+    init = TRUE;
+    if (_NSGetExecutablePath(raw, &size) == 0
+        && realpath(raw, dir) != NULL) {
+      char *slash = strrchr(dir, '/');
+
+      if (slash != NULL) {
+        size_t len;
+
+        *slash = '\0';
+        len = strlen(dir);
+        in_bundle = (len > 15
+                     && strcmp(dir + len - 15, "/Contents/MacOS") == 0);
+      }
+    }
+  }
+
+  return in_bundle ? dir : NULL;
+}
+
+/************************************************************************//**
+  MSP: the app bundle's Contents/Resources directory, or NULL when not
+  running from inside an app bundle.
+****************************************************************************/
+const char *macos_bundle_resources_dir(void)
+{
+  static char res[PATH_MAX];
+  const char *exe_dir = macos_bundle_exe_dir();
+
+  if (exe_dir == NULL) {
+    return NULL;
+  }
+  if (res[0] == '\0') {
+    /* Swap the trailing "/MacOS" for "/Resources" */
+    fc_snprintf(res, sizeof(res), "%.*s/Resources",
+                (int) (strlen(exe_dir) - 6), exe_dir);
+  }
+
+  return res;
+}
+#endif /* __APPLE__ */
