+		if (text.StartsWith("Extracting the CD image "))
+		{
+			busy.reset();
+			busy = std::make_unique<wxBusyInfo>("Extracting the game's CD image...");
+		}
+		else
+			errors += (errors.empty() ? "" : "\n") + text;
+	});
