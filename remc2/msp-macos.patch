@@ -0,0 +1,53 @@
+#pragma once
+// Mac Source Ports: where the macOS build finds its files. Shared by the game
+// and the launcher (remc2-configurator), so it uses neither SDL nor spdlog.
+//
+// The files the game ships with (fonts, shaders, config.json, images, the
+// enhanced assets) are in the app bundle's Resources folder. The original
+// games go in ~/Library/Application Support:
+//
+//   MagicCarpet2  Magic Carpet 2 (GOG): the GAME folder (or GAME/NETHERW),
+//                 game.gog and game.ins. game.gog is extracted to CD_Files,
+//                 its audio tracks (the speech) to CD_Files/SPEECH.
+//   MagicCarpet   Magic Carpet / Hidden Worlds (GOG Magic Carpet Plus): the
+//                 CARPET.CD folder. The CARPET folder of its game.gog is
+//                 extracted to CD_Files.
+//
+// config.json (made from the app's one by the launcher) and the log are in
+// MagicCarpet2. The paths of config.json are mapped there: "MC2/NETHERW" is
+// MagicCarpet2/NETHERW or MagicCarpet2/GAME/NETHERW, "MC1/CARPET.CD" is
+// MagicCarpet/CARPET.CD.
+#ifdef __APPLE__
+#include <filesystem>
+#include <functional>
+#include <string>
+#include <vector>
+
+// Magic Carpet / Hidden Worlds (remc1) is still being ported upstream (the
+// creatures, the icons of the frame and the sounds are stubs, see
+// remc1/docs/handover.md), so the app shows Magic Carpet 2 only. 1 shows
+// the Play buttons of MC1 and Hidden Worlds and extracts their CD image.
+#define MSP_MC1_ENABLED 0
+constexpr bool kMspMc1Enabled = MSP_MC1_ENABLED;
+
+// ~/Library/Application Support/<folder>, created when missing
+std::filesystem::path MspAppSupportDir(const char* folder);
+
+// <app>/Contents/Resources (or the executable's folder outside an app)
+std::filesystem::path MspResourcesDir();
+
+// The Application Support locations of a relative config.json path such as
+// "MC2/NETHERW" (none for other paths)
+std::vector<std::filesystem::path> MspDataLocations(const std::filesystem::path& path);
+
+// The config.json path for a folder in Application Support or the app, e.g.
+// MagicCarpet2/GAME/NETHERW -> MC2/GAME/NETHERW (else the path as it is)
+std::filesystem::path MspConfigPath(const std::filesystem::path& absolutePath);
+
+// Extracts the GOG CD images found in Application Support (see above) that
+// aren't extracted yet. log gets what is done and what went wrong.
+void MspPrepareGameData(const std::function<void(const std::string&)>& log);
+
+// The text telling the player where the files of the games go
+std::string MspMissingDataText();
+#endif
