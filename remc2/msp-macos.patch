diff --git a/remc2/portability/msp_macos.cpp b/remc2/portability/msp_macos.cpp
new file mode 100644
index 00000000..12a75f91
--- /dev/null
+++ b/remc2/portability/msp_macos.cpp
@@ -0,0 +1,416 @@
+// Mac Source Ports: see msp_macos.h
+#ifdef __APPLE__
+#include "msp_macos.h"
+
+#include <mach-o/dyld.h>
+#include <strings.h>
+#include <algorithm>
+#include <climits>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <regex>
+#include <system_error>
+
+namespace fs = std::filesystem;
+
+namespace
+{
+	struct GameFolder
+	{
+		const char* configPrefix;//the first folder of the paths in config.json
+		const char* appSupport;//its folder in Application Support
+	};
+	const GameFolder kGameFolders[] = {
+		{ "MC2", "MagicCarpet2" },
+		{ "MC1", "MagicCarpet" },
+	};
+
+	std::string Lower(std::string s)
+	{
+		for (auto& c : s)
+			c = (char)tolower((unsigned char)c);
+		return s;
+	}
+}
+
+fs::path MspAppSupportDir(const char* folder)
+{
+	const char* home = std::getenv("HOME");
+	fs::path dir = fs::path(home ? home : "") / "Library" / "Application Support" / folder;
+	std::error_code ec;
+	fs::create_directories(dir, ec);
+	return dir;
+}
+
+fs::path MspResourcesDir()
+{
+	char exe[PATH_MAX];
+	uint32_t size = sizeof(exe);
+	if (_NSGetExecutablePath(exe, &size) != 0)
+		return fs::path();
+	char real[PATH_MAX];
+	const fs::path macos = fs::path(realpath(exe, real) ? real : exe).parent_path();
+	const fs::path resources = macos.parent_path() / "Resources";
+	std::error_code ec;
+	if (macos.filename() == "MacOS" && fs::is_directory(resources, ec))
+		return resources;
+	return macos;
+}
+
+std::vector<fs::path> MspDataLocations(const fs::path& path)
+{
+	std::vector<fs::path> locations;
+	if (path.empty() || path.is_absolute())
+		return locations;
+	auto it = path.begin();
+	const std::string prefix = it->string();
+	for (const auto& game : kGameFolders)
+	{
+		if (strcasecmp(prefix.c_str(), game.configPrefix) != 0)
+			continue;
+		fs::path rest;
+		for (++it; it != path.end(); ++it)
+			rest /= *it;
+		const fs::path root = MspAppSupportDir(game.appSupport);
+		locations.push_back(root / rest);
+		// Magic Carpet 2's GOG folders as they are (GAME/NETHERW)
+		if (strcmp(game.configPrefix, "MC2") == 0)
+			locations.push_back(root / "GAME" / rest);
+	}
+	return locations;
+}
+
+fs::path MspConfigPath(const fs::path& absolutePath)
+{
+	const fs::path path = absolutePath.lexically_normal();
+	auto relativeTo = [&](const fs::path& base, fs::path& out) {
+		const fs::path rel = path.lexically_relative(base.lexically_normal());
+		if (rel.empty() || *rel.begin() == "..")
+			return false;
+		out = rel;
+		return true;
+	};
+	fs::path rel;
+	for (const auto& game : kGameFolders)
+		if (relativeTo(MspAppSupportDir(game.appSupport), rel))
+			return fs::path(game.configPrefix) / rel;
+	if (relativeTo(MspResourcesDir(), rel))
+		return rel;
+	return absolutePath;
+}
+
+namespace
+{
+	struct CueTrack
+	{
+		int number = 0;
+		bool audio = false;
+		long long start = 0;//INDEX 01, in sectors from the start of the file
+	};
+
+	// the tracks of a cue sheet (GOG's game.ins), for its one FILE
+	std::vector<CueTrack> ReadCue(const fs::path& cue)
+	{
+		std::vector<CueTrack> tracks;
+		std::ifstream in(cue);
+		std::string line;
+		const std::regex trackRe(R"(^\s*TRACK\s+(\d+)\s+(\S+))", std::regex::icase);
+		const std::regex indexRe(R"(^\s*INDEX\s+01\s+(\d+):(\d+):(\d+))", std::regex::icase);
+		std::smatch m;
+		while (std::getline(in, line))
+		{
+			if (std::regex_search(line, m, trackRe))
+			{
+				CueTrack t;
+				t.number = std::stoi(m[1]);
+				t.audio = Lower(m[2]) == "audio";
+				tracks.push_back(t);
+			}
+			else if (!tracks.empty() && std::regex_search(line, m, indexRe))
+				tracks.back().start = (std::stoll(m[1]) * 60 + std::stoll(m[2])) * 75 + std::stoll(m[3]);
+		}
+		return tracks;
+	}
+
+	uint32_t Le32(const uint8_t* p)
+	{
+		return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t)p[3] << 24);
+	}
+
+	// The ISO 9660 file system of a CD image of 2048 byte sectors, or of raw
+	// 2352 byte ones (mode 1, or mode 2 form 1), its data track first
+	class Iso9660
+	{
+	public:
+		explicit Iso9660(std::ifstream& image) : m_image(image)
+		{
+			struct Layout { int size, offset; };
+			for (const Layout layout : { Layout{ 2048, 0 }, Layout{ 2352, 16 }, Layout{ 2352, 24 } })
+			{
+				m_sectorSize = layout.size;
+				m_dataOffset = layout.offset;
+				std::vector<uint8_t> pvd;
+				if (ReadSectors(16, 1, pvd) && pvd[0] == 1 && memcmp(&pvd[1], "CD001", 5) == 0)
+				{
+					m_rootExtent = Le32(&pvd[156 + 2]);
+					m_rootLength = Le32(&pvd[156 + 10]);
+					m_valid = true;
+					return;
+				}
+			}
+		}
+
+		bool Valid() const { return m_valid; }
+
+		// the folder of the CD (or all of it when empty) to target
+		bool Extract(const std::string& folder, const fs::path& target)
+		{
+			uint32_t extent = m_rootExtent, length = m_rootLength;
+			if (!folder.empty())
+			{
+				bool found = false;
+				ForEachRecord(extent, length, [&](const std::string& name, bool isDir, uint32_t e, uint32_t l) {
+					if (isDir && !found && strcasecmp(name.c_str(), folder.c_str()) == 0)
+					{
+						extent = e;
+						length = l;
+						found = true;
+					}
+					return true;
+				});
+				if (!found)
+					return false;
+			}
+			return ExtractDirectory(extent, length, target, 0);
+		}
+
+	private:
+		bool ReadSectors(uint32_t lba, uint32_t count, std::vector<uint8_t>& out)
+		{
+			out.resize((size_t)count * 2048);
+			for (uint32_t i = 0; i < count; i++)
+			{
+				m_image.seekg((long long)(lba + i) * m_sectorSize + m_dataOffset);
+				if (!m_image.read((char*)out.data() + (size_t)i * 2048, 2048))
+				{
+					m_image.clear();
+					return false;
+				}
+			}
+			return true;
+		}
+
+		template <typename F>
+		bool ForEachRecord(uint32_t extent, uint32_t length, F f)
+		{
+			std::vector<uint8_t> dir;
+			if (!ReadSectors(extent, (length + 2047) / 2048, dir))
+				return false;
+			size_t pos = 0;
+			while (pos < length)
+			{
+				const uint8_t recordLength = dir[pos];
+				if (recordLength == 0)
+				{
+					pos = (pos / 2048 + 1) * 2048;//records don't cross sectors
+					continue;
+				}
+				const uint8_t* r = &dir[pos];
+				const uint8_t nameLength = r[32];
+				const bool isDir = (r[25] & 0x02) != 0;
+				pos += recordLength;
+				if (nameLength == 1 && (r[33] == 0 || r[33] == 1))
+					continue;//the directory itself and its parent
+				std::string name((const char*)&r[33], nameLength);
+				if (!isDir)
+				{
+					if (auto semi = name.find(';'); semi != std::string::npos)
+						name.erase(semi);
+					if (!name.empty() && name.back() == '.')
+						name.pop_back();
+				}
+				if (name.empty() || name == "." || name == ".." || name.find('/') != std::string::npos)
+					continue;
+				if (!f(name, isDir, Le32(&r[2]), Le32(&r[10])))
+					return false;
+			}
+			return true;
+		}
+
+		bool ExtractDirectory(uint32_t extent, uint32_t length, const fs::path& target, int depth)
+		{
+			if (depth > 16)
+				return false;
+			std::error_code ec;
+			fs::create_directories(target, ec);
+			return ForEachRecord(extent, length, [&](const std::string& name, bool isDir, uint32_t e, uint32_t l) {
+				return isDir ? ExtractDirectory(e, l, target / name, depth + 1) : ExtractFile(e, l, target / name);
+			});
+		}
+
+		bool ExtractFile(uint32_t extent, uint32_t size, const fs::path& file)
+		{
+			std::ofstream out(file, std::ios::binary);
+			std::vector<uint8_t> data;
+			for (uint32_t done = 0; done < size;)
+			{
+				const uint32_t sectors = std::min<uint32_t>((size - done + 2047) / 2048, 256);
+				if (!ReadSectors(extent + done / 2048, sectors, data))
+					return false;
+				const uint32_t n = std::min<uint32_t>(size - done, sectors * 2048);
+				out.write((const char*)data.data(), n);
+				done += n;
+			}
+			return (bool)out;
+		}
+
+		std::ifstream& m_image;
+		int m_sectorSize = 2048;
+		int m_dataOffset = 0;
+		uint32_t m_rootExtent = 0, m_rootLength = 0;
+		bool m_valid = false;
+	};
+
+	bool WriteWav(const fs::path& file, std::ifstream& image, long long begin, long long end)
+	{
+		std::ofstream out(file, std::ios::binary);
+		const uint32_t size = (uint32_t)(end - begin);
+		auto put32 = [&](uint32_t v) { out.write((const char*)&v, 4); };
+		auto put16 = [&](uint16_t v) { out.write((const char*)&v, 2); };
+		out.write("RIFF", 4); put32(36 + size); out.write("WAVEfmt ", 8);
+		put32(16); put16(1); put16(2); put32(44100); put32(44100 * 4); put16(4); put16(16);
+		out.write("data", 4); put32(size);
+		std::vector<char> buffer(2352 * 256);
+		image.seekg(begin);
+		for (long long left = size; left > 0;)
+		{
+			const auto n = (std::streamsize)std::min<long long>(left, buffer.size());
+			if (!image.read(buffer.data(), n))
+				return false;
+			out.write(buffer.data(), n);
+			left -= n;
+		}
+		return (bool)out;
+	}
+
+	// a file of the folder, matched without case
+	fs::path FindFile(const fs::path& folder, const char* name)
+	{
+		std::error_code ec;
+		for (fs::directory_iterator it(folder, ec), end; !ec && it != end; it.increment(ec))
+			if (strcasecmp(it->path().filename().c_str(), name) == 0)
+				return it->path();
+		return fs::path();
+	}
+
+	// Extracts the image (its folder, or all of it) to root/CD_Files, and with
+	// the cue sheet its audio tracks to CD_Files/SPEECH/TRACK01.WAV... numbered
+	// from the first audio track (CD track 2), as remc2's own speech files are
+	void ExtractCdImage(const fs::path& root, const fs::path& image, const fs::path& cue, const std::string& folder,
+		const std::function<void(const std::string&)>& log)
+	{
+		const fs::path cdFiles = root / "CD_Files";
+		std::ifstream in(image, std::ios::binary);
+		Iso9660 iso(in);
+		if (!in || !iso.Valid())
+		{
+			log("Can't read the CD image " + image.string());
+			return;
+		}
+
+		log("Extracting the CD image " + image.string() + " to " + cdFiles.string());
+		const fs::path temp = root / "CD_Files.extracting";
+		std::error_code ec;
+		fs::remove_all(temp, ec);
+		if (!iso.Extract(folder, temp))
+		{
+			log("Extracting the CD image failed");
+			fs::remove_all(temp, ec);
+			return;
+		}
+
+		if (!cue.empty())
+		{
+			const std::vector<CueTrack> tracks = ReadCue(cue);
+			in.clear();
+			in.seekg(0, std::ios::end);
+			const long long imageSize = in.tellg();
+			const fs::path speech = temp / "SPEECH";
+			fs::create_directories(speech, ec);
+			int audioTrack = 0;
+			for (size_t i = 0; i < tracks.size(); i++)
+			{
+				if (!tracks[i].audio)
+					continue;
+				char name[16];
+				snprintf(name, sizeof(name), "TRACK%02d.WAV", ++audioTrack);
+				const long long begin = tracks[i].start * 2352;
+				const long long end = i + 1 < tracks.size() ? tracks[i + 1].start * 2352 : imageSize;
+				if (!WriteWav(speech / name, in, begin, std::max(begin, end)))
+					log(std::string("Can't extract the audio track ") + name);
+			}
+		}
+
+		fs::rename(temp, cdFiles, ec);
+		if (ec)
+			log("Can't move " + temp.string() + " to " + cdFiles.string() + ": " + ec.message());
+	}
+}
+
+void MspPrepareGameData(const std::function<void(const std::string&)>& log)
+{
+	std::error_code ec;
+
+	// Magic Carpet 2: game.gog and game.ins next to GAME (or in it)
+	{
+		const fs::path root = MspAppSupportDir("MagicCarpet2");
+		if (!fs::is_directory(root / "CD_Files" / "DATA", ec))
+		{
+			for (const fs::path& folder : { root, root / "GAME" })
+			{
+				const fs::path image = FindFile(folder, "game.gog");
+				const fs::path cue = FindFile(folder, "game.ins");
+				if (!image.empty() && !cue.empty())
+				{
+					ExtractCdImage(root, image, cue, "", log);
+					break;
+				}
+			}
+		}
+	}
+
+	// Magic Carpet / Hidden Worlds: CARPET.CD/game.gog, its CARPET folder
+	if (kMspMc1Enabled)
+	{
+		const fs::path root = MspAppSupportDir("MagicCarpet");
+		if (!fs::is_directory(root / "CD_Files" / "DATA", ec))
+		{
+			for (const fs::path& folder : { root / "CARPET.CD", root })
+			{
+				const fs::path image = FindFile(folder, "game.gog");
+				if (!image.empty())
+				{
+					ExtractCdImage(root, image, fs::path(), "CARPET", log);
+					break;
+				}
+			}
+		}
+	}
+}
+
+std::string MspMissingDataText()
+{
+	std::string text = kMspMc1Enabled ? "The games' files go in your Application Support folder:\n\n"
+		: "The game's files go in your Application Support folder:\n\n";
+	text += "Magic Carpet 2 (GOG's Magic Carpet 2: The Netherworlds): its GAME folder, "
+		"game.gog and game.ins go in\n" + MspAppSupportDir("MagicCarpet2").string() + "\n\n";
+	if (kMspMc1Enabled)
+		text += "Magic Carpet and Hidden Worlds (GOG's Magic Carpet Plus): its CARPET.CD folder goes in\n" +
+			MspAppSupportDir("MagicCarpet").string() + "\n\n";
+	text += "They're in the folder GOG installed the game to, or extract the Windows installer with "
+		"innoextract. The CD images are extracted the first time the game starts.";
+	return text;
+}
+#endif
